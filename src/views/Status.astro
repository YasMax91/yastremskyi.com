---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import { site } from '../data/site';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
import {
  fetchSnapshot,
  dayState,
  dayLabel,
  formatPercent,
  formatMs,
  formatCount,
  type StatusDay,
  type StatusRoute,
} from '../data/status';

/**
 * The status page.
 *
 * Built with a snapshot taken at build time and refreshed by one fetch in the
 * browser, so it says something true with JavaScript disabled instead of an
 * empty frame. The snapshot is dated in the markup: a number without the moment
 * it was taken is not a measurement.
 *
 * The build must not depend on the endpoint being up — a status service having a
 * bad day cannot be allowed to break the deploy that might fix it — so the fetch
 * is best-effort and a failure renders the page in its "no data yet" state.
 */
const initial = await fetchSnapshot(new URL('/api/status', site.origin).href);
const takenAt = initial?.generatedAt ?? null;

/** Thirty slots always render, so the bar does not change width as data arrives. */
const slots: (StatusDay | null)[] = Array.from(
  { length: 30 },
  (_, i) => initial?.days?.[i] ?? null,
);

const commitUrl = (commit: string) => (site.repo ? `${site.repo}/commit/${commit}` : null);
---

<Base
  title="Status"
  description="Live availability, response time and quality gates for this site — measured from outside the server, because a service cannot report its own downtime."
  current="/status"
  locale={locale}
  ogCard="status"
>
  <div class="page-head">
    <div class="wrap">
      <p class="label">Status</p>
      <h1>Is it up</h1>
      <p class="lede">
        Availability and response time for this site, and the result of the gates its last commit
        had to pass. Everything on this page is measured; nothing is asserted.
      </p>
      <p class="nda">
        Uptime is measured <strong>from outside</strong>, by a scheduled job that requests the
        public URL every ten minutes and posts what it saw. That indirection is the point: a service
        cannot report its own downtime, so a page fed only by the server would be a page that is
        always up. Nothing here counts visitors — the site runs no analytics, and a status page is
        not a side door for adding some.
      </p>
    </div>
  </div>

  <Section
    label="Availability"
    title="Thirty days"
    lead="One column per day. A day with no probe is blank rather than green — an unknown is not a success."
  >
    <div class="bar" role="img" aria-label="Daily availability for the last thirty days">
      {
        slots.map((day) => (
          <span class={`d d-${dayState(day)}`} data-slot title={dayLabel(day)}>
            <span class="visually-hidden">{dayLabel(day)}</span>
          </span>
        ))
      }
    </div>

    <dl class="stats m-stagger">
      <div>
        <dt class="num" data-k="availability">{formatPercent(initial?.uptime?.availability)}</dt>
        <dd>availability, 30 days</dd>
      </div>
      <div>
        <dt class="num" data-k="checks">{formatCount(initial?.uptime?.checks)}</dt>
        <dd>checks recorded</dd>
      </div>
      <div>
        <dt class="num" data-k="failures">{formatCount(initial?.uptime?.failures)}</dt>
        <dd>failed checks</dd>
      </div>
      <div>
        <dt class="num" data-k="p50">{formatMs(initial?.latency?.p50)}</dt>
        <dd>response, median</dd>
      </div>
      <div>
        <dt class="num" data-k="p95">{formatMs(initial?.latency?.p95)}</dt>
        <dd>response, 95th</dd>
      </div>
    </dl>

    <p class="asof">
      <span data-k="freshness">
        {
          takenAt
            ? `Snapshot taken at build time, ${takenAt}. Probed every 10 minutes.`
            : 'No probe data yet. The page will fill in once the scheduled check has run.'
        }
      </span>
    </p>
  </Section>

  <Section
    label="Quality gates"
    title="What the last commit had to pass"
    lead="These are the numbers CI measured on the commit currently in production, not numbers from a screenshot in a README."
  >
    <div class="gates" data-k="gates" data-repo={site.repo ?? undefined}>
      {
        initial?.gates ? (
          <>
            <p class="line">
              <span class="key">CI</span>
              <span class="val">{initial.gates.ci}</span>
            </p>
            <p class="line">
              <span class="key">Commit</span>
              <span class="val">
                {commitUrl(initial.gates.commit) ? (
                  <a href={commitUrl(initial.gates.commit)}>{initial.gates.commit}</a>
                ) : (
                  initial.gates.commit
                )}
              </span>
            </p>
            {initial.gates.routes?.length > 0 && (
              <table>
                <thead>
                  <tr>
                    <th scope="col">Route</th>
                    <th scope="col">Performance</th>
                    <th scope="col">LCP</th>
                  </tr>
                </thead>
                <tbody>
                  {initial.gates.routes.map((r: StatusRoute) => (
                    <tr>
                      <td>{r.route}</td>
                      <td class="num-cell">{r.performance}</td>
                      <td class="num-cell">{r.lcp} ms</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )}
          </>
        ) : (
          <p class="empty">No gate report yet. CI posts one after each green run on main.</p>
        )
      }
    </div>
  </Section>

  <Section
    label="Services"
    title="What is running"
    lead="The contact endpoint is the one that matters: it is the only channel on this site that can fail quietly."
    last
  >
    <dl class="kv">
      <div>
        <dt>Contact endpoint</dt>
        <dd data-k="contact">
          {initial?.contact ? (initial.contact.ok ? 'answering' : 'not answering') : '—'}
        </dd>
      </div>
      <div>
        <dt>TLS certificate</dt>
        <dd data-k="tls">
          {
            initial?.tls?.daysRemaining === null || initial?.tls?.daysRemaining === undefined
              ? '—'
              : `${initial.tls.daysRemaining} days remaining`
          }
        </dd>
      </div>
      <div>
        <dt>Node</dt>
        <dd data-k="node">{initial?.service?.node ?? '—'}</dd>
      </div>
      <div>
        <dt>Source</dt>
        <dd>{site.repo ? <a href={site.repo}>the code behind this page</a> : 'private'}</dd>
      </div>
    </dl>
  </Section>
</Base>

<script>
  /**
   * Progressive refresh. The page already says something true without this; all
   * this does is replace a build-time snapshot with the current one, in a single
   * request. On failure it changes nothing, which leaves the dated snapshot
   * standing rather than blanking the page.
   */
  const pct = (v: number | null) => (v == null ? '—' : `${(v * 100).toFixed(2)}%`);
  const ms = (v: number | null) => (v == null ? '—' : `${Math.round(v)} ms`);

  const set = (key: string, value: string) => {
    const el = document.querySelector(`[data-k="${key}"]`);
    if (el) el.textContent = value;
  };

  fetch('/api/status', { headers: { Accept: 'application/json' } })
    .then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
    .then((d) => {
      set('availability', pct(d.uptime?.availability ?? null));
      set('checks', String(d.uptime?.checks ?? '—'));
      set('failures', String(d.uptime?.failures ?? '—'));
      set('p50', ms(d.latency?.p50 ?? null));
      set('p95', ms(d.latency?.p95 ?? null));
      set('node', d.service?.node ?? '—');
      set('contact', d.contact ? (d.contact.ok ? 'answering' : 'not answering') : '—');
      set('tls', d.tls?.daysRemaining == null ? '—' : `${d.tls.daysRemaining} days remaining`);
      set(
        'freshness',
        d.probe?.stale
          ? `No probe since ${d.probe.lastAt ?? 'ever'} — this data is stale, not current.`
          : `Live as of ${d.generatedAt}. Probed every ${d.probe?.intervalMinutes ?? 10} minutes.`,
      );

      // The gates block is server-rendered markup, so the refresh has to rebuild
      // it rather than swap a number. Without this a page built before the first
      // CI report would keep saying "no gate report yet" while the endpoint has
      // one — the page would be stale about the very thing it is showing off.
      const gates = document.querySelector('[data-k="gates"]');
      if (gates && d.gates) {
        const rows = (d.gates.routes ?? [])
          .map(
            (r: { route: string; performance: number; lcp: number }) =>
              `<tr><td>${r.route}</td><td class="num-cell">${r.performance}</td>` +
              `<td class="num-cell">${r.lcp} ms</td></tr>`,
          )
          .join('');
        const repo = gates.getAttribute('data-repo');
        const commit = repo
          ? `<a href="${repo}/commit/${d.gates.commit}">${d.gates.commit}</a>`
          : d.gates.commit;
        gates.innerHTML =
          `<p class="line"><span class="key">CI</span><span class="val">${d.gates.ci}</span></p>` +
          `<p class="line"><span class="key">Commit</span><span class="val">${commit}</span></p>` +
          (rows
            ? '<table><thead><tr><th scope="col">Route</th><th scope="col">Performance</th>' +
              `<th scope="col">LCP</th></tr></thead><tbody>${rows}</tbody></table>`
            : '');

        // Astro scopes this component's CSS by adding a `data-astro-cid-*`
        // attribute to every element it rendered, and selectors carry the same
        // attribute. Markup built here has no such attribute, so without this it
        // renders completely unstyled — which looked fine in a DOM assertion and
        // obvious in a screenshot. The attribute name is read off the container
        // rather than hard-coded, because its hash changes whenever this file
        // does.
        const scope = [...gates.attributes]
          .map((a) => a.name)
          .find((n) => n.startsWith('data-astro-cid-'));
        if (scope) {
          for (const el of gates.querySelectorAll('*')) el.setAttribute(scope, '');
        }
      }

      const slots = document.querySelectorAll<HTMLElement>('[data-slot]');
      slots.forEach((slot, i) => {
        const day = d.days?.[i];
        const state =
          !day || day.checks === 0
            ? 'none'
            : day.failures === 0
              ? 'up'
              : day.availability != null && day.availability < 0.95
                ? 'down'
                : 'partial';
        slot.className = `d d-${state}`;
        const label = day ? `${day.date}: ${day.checks} checks, ${day.failures} failed` : 'No data';
        slot.title = label;
        const sr = slot.firstElementChild;
        if (sr) sr.textContent = label;
      });
    })
    .catch(() => {
      /* The build-time snapshot stays, still honestly dated. */
    });
</script>

<style>
  .page-head {
    padding: var(--space-10) 0 var(--space-8);
    border-bottom: var(--rule) solid var(--border);
  }

  .lede {
    max-width: var(--measure);
    margin-top: var(--space-4);
    font-size: var(--text-lg);
  }

  .nda {
    max-width: var(--measure);
    margin-top: var(--space-5);
    padding-left: var(--space-4);
    border-left: var(--rule) solid var(--accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.7;
    color: var(--ink-muted);
  }

  .bar {
    display: grid;
    grid-template-columns: repeat(30, 1fr);
    gap: 2px;
    margin-bottom: var(--space-6);
  }

  .d {
    height: 3rem;
    background: var(--surface-sunk);
    border: var(--rule) solid var(--border);
  }

  .d-up {
    background: var(--accent);
    border-color: var(--accent);
  }

  .d-partial {
    background: repeating-linear-gradient(-45deg, var(--accent) 0 3px, var(--surface-sunk) 3px 6px);
  }

  .d-down {
    background: var(--ink);
    border-color: var(--ink);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    border-top: var(--rule) solid var(--border);
    border-left: var(--rule) solid var(--border);
  }

  .stats > div {
    padding: var(--space-5) var(--space-4);
    border-right: var(--rule) solid var(--border);
    border-bottom: var(--rule) solid var(--border);
  }

  .stats dt {
    margin-bottom: var(--space-2);
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--display-s);
    line-height: 0.85;
    letter-spacing: var(--tracking-display);
    color: var(--accent);
  }

  .stats dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-label);
    line-height: 1.5;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .asof {
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .line {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-bottom: var(--rule) solid var(--border);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .key {
    min-width: 8rem;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  table {
    width: 100%;
    margin-top: var(--space-6);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  th,
  td {
    padding: var(--space-3) var(--space-2);
    border-bottom: var(--rule) solid var(--border);
    text-align: left;
  }

  th {
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-muted);
    font-weight: var(--weight-regular);
  }

  .num-cell {
    font-variant-numeric: tabular-nums;
  }

  .empty {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }

  .kv {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 0;
    border-top: var(--rule) solid var(--border);
    border-left: var(--rule) solid var(--border);
  }

  .kv > div {
    padding: var(--space-4);
    border-right: var(--rule) solid var(--border);
    border-bottom: var(--rule) solid var(--border);
  }

  .kv dt {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .kv dd {
    margin: var(--space-2) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
</style>
