---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import ContactForm from '../components/ContactForm.astro';
import portrait from '../assets/portrait.jpeg';
import Base from '../layouts/Base.astro';
import GateSimulator from '../components/GateSimulator.astro';
import { site } from '../data/site';
import { useTranslations, localePath, type Locale } from '../i18n/ui';
import { forLocale } from '../i18n/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// Per language, falling back to the English original where a translation does
// not exist yet — and carrying that fact so the card can say so.
const cases = forLocale(await getCollection('work'), locale).sort(
  (a, b) => a.entry.data.order - b.entry.data.order,
);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    // Both spellings, always. The Cyrillic one is what a Ukrainian page shows
    // and the Latin one is what the domain, GitHub, LinkedIn and the CV carry —
    // and a search engine has no way to know they are the same person unless the
    // page says so.
    name: t('site.name'),
    alternateName: locale === 'uk' ? site.name : 'Макс Ястремський',
    jobTitle: 'Senior Backend Engineer, Tech Lead',
    email: `mailto:${site.contact.email}`,
    url: site.origin,
    sameAs: [site.contact.linkedin, site.contact.github, site.groundwork.repo],
    knowsLanguage: site.languages.map((l) => l.name),
    address: { '@type': 'PostalAddress', addressCountry: 'UA' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: t('site.name'),
    url: site.origin,
    inLanguage: locale,
  },
];
---

<Base
  locale={locale}
  title={t('site.name')}
  description={t('home.meta')}
  current="/"
  ogCard={locale === 'en' ? 'default' : `${locale}-default`}
  jsonLd={jsonLd}
>
  <div class="hero">
    <div class="wrap">
      <p class="label">{site.title} · {t('site.experience')}</p>
      <h1>{t('site.nameFirst')}<br />{t('site.nameLast')}</h1>
    </div>

    <div class="wrap">
      <div class="hero-meta">
        <div>
          <p class="label">{t('home.positioning')}</p>
          <p class="lede" set:html={t('home.lede')} />
        </div>
        <div>
          <p class="label">{t('home.facts')}</p>
          <dl class="facts">
            <dt>{t('home.facts.stack')}</dt><dd>PHP 8.4 · Laravel 12 · Node / NestJS</dd>
            <dt>{t('home.facts.data')}</dt><dd>MySQL 8 · Redis · Docker</dd>
            <dt>{t('home.facts.based')}</dt><dd>{t('site.location')}, {site.timezone}</dd>
            <dt>{t('home.facts.openTo')}</dt><dd>{t('site.availability')}</dd>
            <dt>{t('home.facts.markets')}</dt><dd>{t('site.markets')}</dd>
            <dt>{t('home.facts.languages')}</dt>
            <dd>{t('site.languages')}</dd>
          </dl>
        </div>
        <div class="portrait-cell">
          {
            /*
              Treated rather than pasted: grayscale in both themes so the one
              vermilion on the page keeps meaning something, and dimmed in dark
              mode because a near-white brick wall at full brightness punches a
              hole in a black page. The frame crops a little tighter than the
              source, which pulls the composition in.
            */
          }
          <Picture
            class="portrait"
            src={portrait}
            alt={t('site.name')}
            formats={['avif', 'webp']}
            fallbackFormat="jpeg"
            widths={[320, 640, 960]}
            sizes="(min-width: 56rem) 18rem, 12rem"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>

    <div class="wrap">
      <div class="cta">
        <a
          class="btn"
          href={`mailto:${site.contact.email}?subject=${encodeURIComponent(site.contact.emailSubject)}`}
        >
          {t('home.cta.email')}
        </a>
        <a class="btn btn-2" href={site.groundwork.repo}>{t('home.cta.repo')}</a>
      </div>
    </div>
  </div>

  <section id="groundwork" class="m-rule">
    <div class="wrap">
      <div class="sec-head m-reveal">
        <div>
          <p class="label">{t('home.gw.label', { licence: site.groundwork.licence })}</p>
          <h2>Groundwork</h2>
        </div>
        <p class="prose">{t('home.gw.prose')}</p>
      </div>

      <blockquote class="pull m-reveal">{t('home.gw.quote')}</blockquote>

      <dl class="stats m-stagger">
        <div><dt class="num">{site.stats.codebases}</dt><dd>{t('home.stats.codebases')}</dd></div>
        <div><dt class="num">{site.stats.procedureRuns}</dt><dd>{t('home.stats.runs')}</dd></div>
        <div><dt class="num">{site.stats.specsWritten}</dt><dd>{t('home.stats.specs')}</dd></div>
        <div>
          <dt class="num">{site.stats.frontendHandoffs}</dt><dd>{t('home.stats.handoffs')}</dd>
        </div>
        <div>
          <dt class="num">{t('site.oneInThree')}</dt><dd>{t('home.stats.stopped')}</dd>
        </div>
      </dl>
      <p class="asof">{t('meta.asOf')}</p>

      <GateSimulator id="home-sim" locale={locale} />
    </div>
  </section>

  <section id="work" class="m-rule">
    <div class="wrap">
      <div class="sec-head m-reveal">
        <div>
          <p class="label">{t('home.selectedWork')}</p>
          <h2>{t('home.work.title')}</h2>
        </div>
        <p class="prose">{t('home.work.prose')}</p>
      </div>

      <ol class="cases m-stagger">
        <li>
          <span class="n num">01</span>
          <div>
            <h3><a href={localePath('/groundwork', locale)}>Groundwork</a></h3>
            <p>
              {
                t('home.work.gwSummary', {
                  agents: site.groundwork.agents,
                  gates: site.groundwork.gates,
                  procedures: site.groundwork.procedures,
                  licence: site.groundwork.licence,
                })
              }
            </p>
          </div>
          <div class="subtle">
            <b>{t('home.subtle')}</b>
            <span>{t('home.work.gwSubtle')}</span>
          </div>
        </li>
        {
          cases.map(({ entry, slug }, i) => (
            <li>
              <span class="n num">0{i + 2}</span>
              <div>
                <h3>
                  <a href={localePath(`/work/${slug}`, locale)}>{entry.data.title}</a>
                </h3>
                <p>{entry.data.summary}</p>
                <ul class="tags">
                  {entry.data.stack.map((chip) => (
                    <li>{chip}</li>
                  ))}
                </ul>
              </div>
              <div class="subtle">
                <b>{t('home.subtle')}</b>
                <span>{entry.data.subtle.split('\n\n')[0]}</span>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="capabilities" class="m-rule">
    <div class="wrap">
      <div class="sec-head m-reveal">
        <div>
          <p class="label">{t('home.capabilities')}</p>
          <h2>{t('home.caps.title')}</h2>
        </div>
        <p class="prose">{t('home.caps.prose')}</p>
      </div>
      <div class="caps m-stagger">
        {
          site.capabilities.map((group) => (
            <div>
              <h3>{t(group.key)}</h3>
              {/* Capability items are terms, not prose: they stay English in
                  every language by the same decision that keeps `backend` and
                  `code review` untranslated. */}
              <ul class="chips">
                {group.items.map((item) => (
                  <li>{t(item)}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="how" class="m-rule">
    <div class="wrap">
      <div class="sec-head m-reveal">
        <div>
          <p class="label">{t('home.howIWork')}</p>
          <h2>{t('home.how.title')}</h2>
        </div>
        <p class="prose">{t('home.how.prose')}</p>
      </div>
      <div class="prin m-stagger">
        {
          site.principles.map((p) => (
            <div>
              <h3>{t(p.titleKey)}</h3>
              <p>{t(p.bodyKey)}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="contact" class="last">
    <div class="wrap">
      <div class="sec-head m-reveal">
        <div>
          <p class="label">{t('home.contact')}</p>
          <h2>{t('home.contact.title')}</h2>
        </div>
        <p class="prose">
          {t('home.contact.prose', { availability: t('site.availability').toLowerCase() })}
        </p>
      </div>
      <div class="contact-grid m-reveal">
        <ContactForm locale={locale} />
        <div class="elsewhere">
          <h3>{t('home.elsewhere')}</h3>
          <ul>
            <li><a href={site.contact.linkedin}>LinkedIn</a></li>
            <li><a href={site.contact.github}>GitHub</a></li>
            <li><a href={site.groundwork.repo}>Groundwork</a></li>
            <li><a href="/cv">CV</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    border-bottom: var(--rule) solid var(--border);
    padding-top: var(--space-8);
  }

  h1 {
    font-size: var(--display-xl);
    margin: 0 0 0.2em;
  }

  .hero-meta {
    display: grid;
    border-top: var(--rule) solid var(--border);
  }

  @media (min-width: 56rem) {
    .hero-meta {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr) minmax(0, 18rem);
    }
  }

  .hero-meta > div {
    padding: var(--space-5) var(--space-5) var(--space-5) 0;
  }

  @media (min-width: 56rem) {
    .hero-meta {
      align-items: stretch;
    }
  }

  @media (min-width: 56rem) {
    .hero-meta > div + div {
      padding-left: var(--space-5);
      border-left: var(--rule) solid var(--border);
    }
  }

  .lede {
    max-width: 30ch;
    margin-top: var(--space-3);
    font-size: var(--text-xl);
    line-height: var(--leading-tight);
  }

  .lede b {
    padding: 0 0.18em;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: var(--weight-regular);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .facts {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.35rem var(--space-3);
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .facts dt {
    color: var(--ink-muted);
  }

  .facts dd {
    margin: 0;
  }

  /* The photo is a block in the grid, flush with the rules that bound it —
     not a picture floating inside a padded cell. */
  .portrait-cell {
    padding: 0 !important;
  }

  /* Sized from a measurement, not a preference. At 412px the portrait was
     157,879px of the viewport against 31,642px for the headline, which made the
     photograph the largest contentful paint and pushed LCP to 1.50s — removing
     it from the built page dropped LCP to 1.05s, which is how we know.
     At document size it is smaller than the positioning sentence beside it, so
     the sentence becomes the largest element and the page paints on text rather
     than on an image decode. It also reads better: on a phone the hero should
     lead with the name and the claim, not with a face. */
  .portrait {
    display: block;
    width: 100%;
    max-width: 12rem;
    height: 100%;
    max-height: 26rem;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 24%;
    filter: grayscale(1) contrast(1.06);
  }

  @media (min-width: 56rem) {
    .portrait {
      max-width: none;
    }
  }

  @media (min-width: 56rem) {
    .portrait {
      aspect-ratio: auto;
      max-height: none;
    }
  }

  /* On a black page the white brick behind him would otherwise read as a lamp. */
  :global(:root[data-theme='dark']) .portrait {
    filter: grayscale(1) contrast(1.02) brightness(0.78);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .portrait {
      filter: grayscale(1) contrast(1.02) brightness(0.78);
    }
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    border: var(--rule) solid var(--border);
    border-inline: 0;
  }

  .btn {
    flex: 1 1 16rem;
    padding: var(--space-4);
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .btn + .btn {
    border-left: var(--rule) solid var(--border);
  }

  .btn-2 {
    background: var(--surface);
    color: var(--ink);
  }

  .btn-2:hover {
    background: var(--ink);
    color: var(--surface);
  }

  section {
    position: relative;
    padding: var(--space-10) 0;
  }

  /* Was `border-bottom`. A border cannot be drawn from the left; a positioned
     hairline can, and it lands on the same pixel row. `.m-rule` in motion.css
     sets it in motion and touches no property declared here. */
  section::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: var(--rule);
    background: var(--border);
  }

  /* The last section closes against the footer, which draws its own top rule.
     Two hairlines on one pixel row is a 4px line nobody designed, and a rule
     that sits at the very bottom of the document is also the one rule a
     scroll-driven draw can never finish. Dropping it settles both. */
  section.last::after {
    display: none;
  }

  @media (min-width: 48rem) {
    section {
      padding: var(--space-16) 0;
    }
  }

  .sec-head {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }

  @media (min-width: 56rem) {
    .sec-head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
      gap: var(--space-8);
      align-items: end;
    }
  }

  .sec-head h2 {
    font-size: var(--display-m);
  }

  .sec-head .prose {
    color: var(--ink-muted);
  }

  .pull {
    max-width: 36ch;
    margin-bottom: var(--space-8);
    padding-left: var(--space-5);
    border-left: 8px solid var(--accent);
    font-size: var(--text-xl);
    line-height: var(--leading-tight);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    border-top: var(--rule) solid var(--border);
    border-left: var(--rule) solid var(--border);
  }

  .stats > div {
    padding: var(--space-5) var(--space-4);
    border-right: var(--rule) solid var(--border);
    border-bottom: var(--rule) solid var(--border);
  }

  .stats dt {
    margin-bottom: var(--space-2);
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--display-s);
    line-height: 0.85;
    letter-spacing: var(--tracking-display);
    color: var(--accent);
  }

  .stats dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .asof {
    margin: var(--space-3) 0 var(--space-10);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .contact-grid {
    display: grid;
    gap: var(--space-8);
  }

  @media (min-width: 56rem) {
    .contact-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 16rem);
    }
  }

  .elsewhere h3 {
    margin-bottom: var(--space-4);
    font-size: var(--text-lg);
  }

  .elsewhere ul {
    padding: 0;
    border-top: var(--rule-thin) solid var(--border);
    list-style: none;
  }

  .elsewhere li {
    padding: var(--space-3) 0;
    border-bottom: var(--rule-thin) solid var(--border);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .cases {
    border-top: var(--rule) solid var(--border);
    padding: 0;
    list-style: none;
  }

  .cases li {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-8) 0;
    border-bottom: var(--rule) solid var(--border);
  }

  @media (min-width: 60rem) {
    .cases li {
      grid-template-columns: minmax(0, 8rem) minmax(0, 1fr) minmax(0, 22rem);
    }
  }

  .cases .n {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--display-s);
    line-height: 0.8;
    letter-spacing: var(--tracking-display);
    color: var(--accent-text);
  }

  .cases h3 {
    margin-bottom: var(--space-3);
    font-size: var(--display-s);
  }

  .cases h3 a {
    text-decoration-thickness: 0.05em;
  }

  .cases p {
    max-width: 54ch;
    color: var(--ink-muted);
  }

  .subtle {
    padding: var(--space-4);
    border: var(--rule) solid var(--accent);
  }

  .subtle b {
    display: block;
    margin-bottom: var(--space-2);
    font-family: var(--font-mono);
    font-weight: var(--weight-regular);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .subtle span {
    font-size: var(--text-sm);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-top: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 0.16rem 0.45rem;
    border: var(--rule-thin) solid var(--border);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .caps,
  .prin {
    display: grid;
    border-top: var(--rule) solid var(--border);
    border-left: var(--rule) solid var(--border);
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }

  .caps > div,
  .prin > div {
    padding: var(--space-5);
    border-right: var(--rule) solid var(--border);
    border-bottom: var(--rule) solid var(--border);
  }

  .caps h3 {
    margin-bottom: var(--space-4);
    font-size: var(--text-lg);
  }

  .caps ul {
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 2;
    color: var(--ink-muted);
  }

  .prin h3 {
    margin-bottom: var(--space-3);
    font-size: var(--text-xl);
    color: var(--accent-text);
  }

  .prin p {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
</style>
