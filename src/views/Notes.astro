---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { useTranslations, localePath, type Locale } from '../i18n/ui';
import UntranslatedNotice from '../components/UntranslatedNotice.astro';

/**
 * The whole notes section — index and posts — in one route.
 *
 * When the collection is empty this returns no paths at all, so /notes does not
 * exist: no empty page, no dead link in a sitemap, nothing for a reader to be
 * disappointed by. The moment a file lands in src/content/notes/ the index and
 * the post both appear.
 */
interface Props {
  items: { entry: CollectionEntry<'notes'>; slug: string; translated: boolean }[];
  post?: CollectionEntry<'notes'>;
  translated?: boolean;
  locale: Locale;
}

const { items, post, translated = false, locale } = Astro.props;
const t = useTranslations(locale);
// Null on the index, a component on a post. Narrowed at the call site rather
// than asserted, so the index cannot accidentally try to render a body.
const Content = post ? (await render(post)).Content : null;

// The date reads in the page's language: "20 серпня 2026", not "20 August 2026"
// under a Ukrainian heading.
const dateFormat = new Intl.DateTimeFormat(locale === 'uk' ? 'uk-UA' : 'en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

{
  post ? (
    <Base locale={locale} title={post.data.title} description={post.data.summary} current="/notes">
      <div class="page-head">
        <div class="wrap">
          <UntranslatedNotice locale={locale} translated={translated} />
          <p class="label">
            <time datetime={post.data.published.toISOString()}>
              {dateFormat.format(post.data.published)}
            </time>
          </p>
          <h1>{post.data.title}</h1>
          <p class="lede">{post.data.summary}</p>
        </div>
      </div>
      <div class="wrap body">{Content && <Content />}</div>
    </Base>
  ) : (
    <Base locale={locale} title={t('notes.label')} description={t('notes.meta')} current="/notes">
      <div class="page-head">
        <div class="wrap">
          <p class="label">{t('notes.label')}</p>
          <h1>{t('notes.title')}</h1>
        </div>
      </div>
      <ol class="list">
        {items.map(({ entry, slug }) => (
          <li>
            <div class="wrap row">
              <time class="when" datetime={entry.data.published.toISOString()}>
                {dateFormat.format(entry.data.published)}
              </time>
              <div>
                <h2>
                  <a href={localePath(`/notes/${slug}`, locale)}>{entry.data.title}</a>
                </h2>
                <p>{entry.data.summary}</p>
              </div>
            </div>
          </li>
        ))}
      </ol>
    </Base>
  )
}

<style>
  .page-head {
    padding: var(--space-10) 0 var(--space-8);
    border-bottom: var(--rule) solid var(--border);
  }

  .page-head h1 {
    margin: var(--space-3) 0 var(--space-5);
    font-size: var(--display-l);
  }

  .lede {
    max-width: 38ch;
    font-size: var(--text-xl);
    line-height: var(--leading-tight);
  }

  .body {
    max-width: var(--measure);
    padding: var(--space-10) 0;
  }

  .body :global(h2) {
    margin: var(--space-8) 0 var(--space-3);
    font-size: var(--display-s);
  }

  .body :global(p) {
    margin-bottom: var(--space-4);
  }

  .body :global(pre) {
    margin-bottom: var(--space-5);
    padding: var(--space-5);
    background: var(--ink);
    color: var(--surface);
    overflow-x: auto;
    font-size: var(--text-sm);
  }

  .list {
    padding: 0;
    list-style: none;
  }

  .list li {
    border-bottom: var(--rule) solid var(--border);
  }

  .row {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-6) 0;
  }

  @media (min-width: 52rem) {
    .row {
      grid-template-columns: minmax(0, 12rem) minmax(0, 1fr);
      gap: var(--space-8);
    }
  }

  .when {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }

  .list h2 {
    margin-bottom: var(--space-2);
    font-size: var(--text-xl);
  }

  .list p {
    max-width: var(--measure);
    color: var(--ink-muted);
  }
</style>
