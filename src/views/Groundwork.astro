---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import GateSimulator from '../components/GateSimulator.astro';
import Stats from '../components/Stats.astro';
import ButtonRow from '../components/ButtonRow.astro';
import Button from '../components/Button.astro';
import { site } from '../data/site';
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

/**
 * This page is case study #1, not a second page about the same thing. `/work`
 * lists Groundwork first and links here rather than carrying a duplicate.
 */

const PROBLEMS = [
  { title: 'gw.p1.title', body: 'gw.p1.body' },
  { title: 'gw.p2.title', body: 'gw.p2.body' },
  { title: 'gw.p3.title', body: 'gw.p3.body' },
  { title: 'gw.p4.title', body: 'gw.p4.body' },
] as const;

const LEVELS = [
  ['L0', 'gw.l0.covers', 'gw.l0.agents', 'gw.l0.approval'],
  ['L1', 'gw.l1.covers', 'gw.l1.agents', 'gw.l1.approval'],
  ['L2', 'gw.l2.covers', 'gw.l2.agents', 'gw.l2.approval'],
  ['L3', 'gw.l3.covers', 'gw.l3.agents', 'gw.l3.approval'],
  ['L4', 'gw.l4.covers', 'gw.l4.agents', 'gw.l4.approval'],
] as const;

const AGENTS = [
  { name: 'impact-mapper', body: 'gw.a1.body' },
  { name: 'blind-spot-mapper', body: 'gw.a2.body' },
  { name: 'grounded-researcher', body: 'gw.a3.body' },
  { name: 'adversarial-verifier', body: 'gw.a4.body' },
  { name: 'conformance-reviewer', body: 'gw.a5.body' },
] as const;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: 'Groundwork',
  description:
    'A Claude Code plugin that makes verification part of the development process: risk-based task classification, five specialised review agents, and gates that must be green before anything is called done.',
  codeRepository: site.groundwork.repo,
  license: 'https://opensource.org/licenses/MIT',
  programmingLanguage: 'Shell',
  author: { '@type': 'Person', name: t('site.name'), url: site.origin },
};
---

<Base
  title="Groundwork"
  description={t('gw.meta')}
  current="/groundwork"
  locale={locale}
  ogCard={locale === 'en' ? 'groundwork' : `${locale}-groundwork`}
  jsonLd={jsonLd}
>
  <div class="page-head">
    <div class="wrap">
      <p class="label">{t('home.gw.label', { licence: site.groundwork.licence })}</p>
      <h1>Groundwork</h1>
      <p class="lede">
        {t('gw.heroA')}
        <b>{t('gw.heroB')}</b>
        {t('gw.heroC')}
      </p>
      <dl class="meta">
        <div><dt>{t('gw.licence')}</dt><dd>{site.groundwork.licence}</dd></div>
        <div><dt>{t('gw.runsIn')}</dt><dd>Claude Code</dd></div>
        <div><dt>{t('gw.targets')}</dt><dd>{t('gw.targetsValue')}</dd></div>
        <div><dt>{t('gw.author')}</dt><dd>{t('site.name')}</dd></div>
      </dl>
    </div>
  </div>

  <Section
    id="problem"
    label={t('gw.problem.label')}
    title={t('gw.problem.title')}
    lead={t('gw.problem.leadFull')}
  >
    <blockquote class="pull">
      {t('home.gw.quote')}
      <cite>{t('gw.problem.lead')}</cite>
    </blockquote>

    <ol class="steps">
      {
        PROBLEMS.map((p, i) => (
          <li>
            <span class="n num">0{i + 1}</span>
            <div>
              <h3>{t(p.title)}</h3>
              <p>{t(p.body)}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section
    id="design"
    label={t('gw.design.label')}
    title={t('gw.design.title')}
    lead={t('gw.design.lead')}
  >
    <div class="table-scroll">
      <table>
        <caption>{t('gw.tableCaption')}</caption>
        <thead>
          <tr>
            <th scope="col">{t('gw.table.level')}</th>
            <th scope="col">{t('gw.table.covers')}</th>
            <th scope="col">{t('gw.table.agents')}</th>
            <th scope="col">{t('gw.table.approval')}</th>
          </tr>
        </thead>
        <tbody>
          {
            LEVELS.map(([level, covers, agents, approval]) => (
              <tr>
                <th scope="row">{level}</th>
                <td>{t(covers)}</td>
                <td>{t(agents)}</td>
                <td>{t(approval)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="sim-slot">
      <GateSimulator id="gw-sim" locale={locale} />
    </div>
  </Section>

  <Section
    id="agents"
    label={t('gw.review.label')}
    title={t('gw.review.title')}
    lead={t('gw.review.lead')}
  >
    <div class="agents">
      {
        AGENTS.map((a) => (
          <div>
            <h3>{a.name}</h3>
            <p>{t(a.body)}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <Section
    id="adoption"
    label={t('gw.adoption.label')}
    title={t('gw.adoption.title')}
    lead={t('gw.adoption.lead')}
  >
    <Stats locale={locale} />
    <div class="callout">
      {
        /* h3, not h4: the section above it is an h2, and skipping a level breaks
          the document outline for anyone navigating by headings. It keeps the
          mono micro-label look through a class rather than through its tag. */
      }
      <h3 class="callout-title">{t('gw.numberTitle')}</h3>
      <p>
        {t('gw.numberBody')}
      </p>
    </div>
  </Section>

  <Section
    id="install"
    label={t('gw.install.label')}
    title={t('gw.install.title')}
    lead={t('gw.install.lead')}
    last
  >
    <pre><code>/plugin marketplace add YasMax91/groundwork
/plugin install groundwork@yasmax
/groundwork:init</code></pre>
    <ButtonRow>
      <Button href={site.groundwork.repo}>{t('gw.readSource')}</Button>
      <Button href={`mailto:${site.contact.email}?subject=Groundwork`} variant="outline">
        {t('gw.askAbout')}
      </Button>
    </ButtonRow>
  </Section>
</Base>

<style>
  .page-head {
    padding: var(--space-10) 0 var(--space-8);
    border-bottom: var(--rule) solid var(--border);
  }

  .page-head h1 {
    margin: var(--space-3) 0 var(--space-5);
    font-size: var(--display-l);
  }

  .lede {
    max-width: 34ch;
    font-size: var(--text-xl);
    line-height: var(--leading-tight);
  }

  .lede b {
    padding: 0 0.18em;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: var(--weight-regular);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: var(--rule-thin) solid var(--border);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .meta div {
    display: flex;
    gap: var(--space-2);
  }

  .meta dt {
    color: var(--ink-muted);
  }

  .meta dd {
    margin: 0;
  }

  .pull {
    max-width: 36ch;
    margin-bottom: var(--space-8);
    padding-left: var(--space-5);
    border-left: 8px solid var(--accent);
    font-size: var(--text-xl);
    line-height: var(--leading-tight);
  }

  .pull cite {
    display: block;
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-style: normal;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .steps {
    padding: 0;
    border-top: var(--rule) solid var(--border);
    list-style: none;
  }

  .steps li {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5) 0;
    border-bottom: var(--rule) solid var(--border);
  }

  @media (min-width: 52rem) {
    .steps li {
      grid-template-columns: minmax(0, 6rem) minmax(0, 1fr);
      gap: var(--space-5);
    }
  }

  .steps .n {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--display-s);
    line-height: 1;
    letter-spacing: var(--tracking-display);
    color: var(--accent-text);
  }

  .steps h3 {
    margin-bottom: var(--space-2);
    font-size: var(--text-xl);
  }

  .steps p {
    max-width: var(--measure);
    color: var(--ink-muted);
  }

  /* Wide tables scroll inside their own box. The page never scrolls sideways. */
  .table-scroll {
    overflow-x: auto;
    border: var(--rule) solid var(--border);
  }

  table {
    width: 100%;
    min-width: 44rem;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  caption {
    padding: var(--space-4);
    border-bottom: var(--rule) solid var(--border);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-label);
    text-align: left;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  th,
  td {
    padding: var(--space-3) var(--space-4);
    border-bottom: var(--rule-thin) solid var(--border);
    text-align: left;
    vertical-align: top;
  }

  thead th {
    border-bottom: var(--rule) solid var(--border);
    font-family: var(--font-mono);
    font-weight: var(--weight-regular);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--ink-muted);
  }

  tbody th {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    white-space: nowrap;
    color: var(--accent-text);
  }

  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: 0;
  }

  .sim-slot {
    margin-top: var(--space-8);
  }

  .agents {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    border-top: var(--rule) solid var(--border);
    border-left: var(--rule) solid var(--border);
  }

  .agents > div {
    padding: var(--space-5);
    border-right: var(--rule) solid var(--border);
    border-bottom: var(--rule) solid var(--border);
  }

  .agents h3 {
    margin-bottom: var(--space-2);
    font-family: var(--font-mono);
    font-weight: var(--weight-regular);
    font-size: var(--text-sm);
    letter-spacing: 0;
    text-transform: none;
    color: var(--accent-text);
  }

  .agents p {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .callout {
    max-width: var(--measure);
    margin-top: var(--space-5);
    padding: var(--space-5);
    border: var(--rule) solid var(--accent);
  }

  .callout-title {
    margin-bottom: var(--space-2);
    font-family: var(--font-mono);
    font-weight: var(--weight-regular);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .callout p {
    font-size: var(--text-sm);
  }

  pre {
    margin-bottom: var(--space-8);
    padding: var(--space-5);
    background: var(--ink);
    color: var(--surface);
    border-radius: var(--radius);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.9;
  }
</style>
