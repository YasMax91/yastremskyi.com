---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { useTranslations, localePath, type Locale } from '../i18n/ui';
import { forLocale } from '../i18n/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// Per language, falling back to the English original where a translation does
// not exist yet — and carrying that fact so the card can say so.
const cases = forLocale(await getCollection('work'), locale).sort(
  (a, b) => a.entry.data.order - b.entry.data.order,
);
---

<Base
  title={t('nav.work')}
  description={t('work.meta')}
  current="/work"
  locale={locale}
  ogCard={locale === 'en' ? 'work' : `${locale}-work`}
>
  <div class="page-head">
    <div class="wrap">
      <p class="label">{t('home.selectedWork')}</p>
      <h1>{t('home.work.title')}</h1>
      <p class="lede">{t('work.lede')}</p>
      <p class="nda">{t('work.nda')}</p>
    </div>
  </div>

  <ol class="cases">
    <li>
      <div class="wrap inner m-reveal">
        <span class="n num">01</span>
        <div>
          <h2><a href={localePath('/groundwork', locale)}>Groundwork</a></h2>
          <p>
            {
              t('work.gwSummary', {
                agents: site.groundwork.agents,
                gates: site.groundwork.gates,
                procedures: site.groundwork.procedures,
                licence: site.groundwork.licence,
              })
            }
          </p>
          <ul class="tags">
            <li>Claude Code</li><li>Bash</li><li>{t('work.gwChip.analysis')}</li><li>OpenAPI</li>
          </ul>
        </div>
        <div class="subtle">
          <b>{t('home.subtle')}</b>
          <span>{t('home.work.gwSubtle')}</span>
        </div>
      </div>
    </li>
    {
      cases.map(({ entry, slug }, i) => (
        <li>
          <div class="wrap inner m-reveal">
            <span class="n num">0{i + 2}</span>
            <div>
              <h2>
                <a href={localePath(`/work/${slug}`, locale)}>{entry.data.title}</a>
              </h2>
              <p>{entry.data.summary}</p>
              <ul class="tags">
                {entry.data.stack.map((chip) => (
                  <li>{chip}</li>
                ))}
              </ul>
            </div>
            <div class="subtle">
              {t('home.subtle')}
              <span>{entry.data.subtle}</span>
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</Base>

<style>
  .page-head {
    padding: var(--space-10) 0 var(--space-8);
    border-bottom: var(--rule) solid var(--border);
  }

  .page-head h1 {
    margin: var(--space-3) 0 var(--space-5);
    font-size: var(--display-l);
  }

  .lede {
    max-width: 38ch;
    font-size: var(--text-xl);
    line-height: var(--leading-tight);
  }

  .nda {
    max-width: var(--measure);
    margin-top: var(--space-5);
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .cases {
    padding: 0;
    list-style: none;
  }

  .cases li {
    position: relative;
    border-bottom: var(--rule) solid var(--border);
  }

  .inner {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-8) 0;
  }

  @media (min-width: 60rem) {
    .inner {
      grid-template-columns: minmax(0, 8rem) minmax(0, 1fr) minmax(0, 22rem);
    }
  }

  .n {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--display-s);
    line-height: 0.8;
    letter-spacing: var(--tracking-display);
    color: var(--accent-text);
  }

  h2 {
    margin-bottom: var(--space-3);
    font-size: var(--display-s);
  }

  .inner p {
    max-width: 54ch;
    color: var(--ink-muted);
  }

  .subtle {
    padding: var(--space-4);
    border: var(--rule) solid var(--accent);
  }

  .subtle b {
    display: block;
    margin-bottom: var(--space-2);
    font-family: var(--font-mono);
    font-weight: var(--weight-regular);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .subtle span {
    font-size: var(--text-sm);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-top: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 0.16rem 0.45rem;
    border: var(--rule-thin) solid var(--border);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
</style>
