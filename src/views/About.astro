---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import ButtonRow from '../components/ButtonRow.astro';
import Button from '../components/Button.astro';
import { site } from '../data/site';
import { useTranslations, renderedLocale, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

/**
 * Employment dates are stored as `YYYY-MM` so each language can render them
 * itself. "Apr 2024" under a Ukrainian heading is the kind of seam a reader
 * notices without being able to say why.
 */
const monthYear = new Intl.DateTimeFormat(renderedLocale(locale) === 'uk' ? 'uk-UA' : 'en-GB', {
  month: 'short',
  year: 'numeric',
});
const when = (value: string) =>
  value === 'present' ? t('tl.present') : monthYear.format(new Date(`${value}-01T00:00:00Z`));
---

<Base
  title={t('about.label')}
  description={t('about.meta')}
  current="/about"
  locale={locale}
  ogCard={locale === 'en' ? 'about' : `${locale}-about`}
>
  <div class="page-head">
    <div class="wrap">
      <p class="label">{t('about.label')}</p>
      <h1>{t('about.title')}</h1>
      <p class="lede">{t('about.lede')}</p>
    </div>
  </div>

  <Section
    label={t('about.career.label')}
    title={t('about.career.title')}
    lead={t('about.career.lead')}
  >
    <ol class="timeline">
      {
        site.timeline.map((job) => (
          <li>
            <div class="when">
              <span class="num">{when(job.from)}</span>
              <span class="num">{when(job.to)}</span>
            </div>
            <div>
              <h3>{job.role}</h3>
              <p class="org">
                {job.org} — {t(job.noteKey)}
              </p>
              <ul>
                {job.highlights.map((h) => (
                  <li>{t(h)}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section
    label={t('about.markets.label')}
    title={t('about.markets.title')}
    lead={t('about.markets.lead')}
  >
    <div class="prose">
      <p set:html={t('about.markets.il')} />
      <p set:html={t('about.markets.ua')} />
    </div>
  </Section>

  <Section label={t('about.lang.label')} title={t('about.lang.title')}>
    <dl class="langs">
      {
        site.languages.map((l) => (
          <div>
            <dt>{t(l.nameKey)}</dt>
            <dd>{t(l.levelKey)}</dd>
          </div>
        ))
      }
    </dl>
    <p class="prose note">{t('about.lang.note')}</p>
  </Section>

  <Section label={t('about.lead.label')} title={t('about.lead.title')} lead={t('about.lead.lead')}>
    <div class="prose">
      <p>{t('about.lead.p1')}</p>
      <p>{t('about.lead.p2')}</p>
    </div>
  </Section>

  <Section
    label={t('about.next.label')}
    title={t('about.next.title')}
    lead={t('about.next.lead')}
    last
  >
    <div class="prose">
      <p>
        {
          t('about.next.body', {
            notice: site.availability.split('·').slice(-1)[0]?.trim() ?? '',
          })
        }
      </p>
    </div>
    <ButtonRow>
      <Button
        href={`mailto:${site.contact.email}?subject=${encodeURIComponent(site.contact.emailSubject)}`}
      >
        {site.contact.email}
      </Button>
      {/* The CV stays English in every locale — see the note in Header.astro. */}
      <Button href="/cv" variant="outline">{t('about.readCv')}</Button>
    </ButtonRow>
  </Section>
</Base>

<style>
  .page-head {
    padding: var(--space-10) 0 var(--space-8);
    border-bottom: var(--rule) solid var(--border);
  }

  .page-head h1 {
    margin: var(--space-3) 0 var(--space-5);
    font-size: var(--display-l);
  }

  .lede {
    max-width: 34ch;
    font-size: var(--text-xl);
    line-height: var(--leading-tight);
  }

  .timeline {
    padding: 0;
    border-top: var(--rule) solid var(--border);
    list-style: none;
  }

  .timeline > li {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-6) 0;
    border-bottom: var(--rule) solid var(--border);
  }

  @media (min-width: 52rem) {
    .timeline > li {
      grid-template-columns: minmax(0, 10rem) minmax(0, 1fr);
      gap: var(--space-8);
    }
  }

  .when {
    display: flex;
    flex-direction: column;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }

  .timeline h3 {
    margin-bottom: var(--space-2);
    font-size: var(--text-xl);
  }

  .org {
    margin-bottom: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent-text);
  }

  .timeline ul {
    max-width: var(--measure);
    padding: 0;
    list-style: none;
  }

  .timeline ul li {
    padding: var(--space-2) 0;
    border-bottom: var(--rule-thin) solid var(--border);
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .timeline ul li:last-child {
    border-bottom: 0;
  }

  .langs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    border-top: var(--rule) solid var(--border);
    border-left: var(--rule) solid var(--border);
  }

  .langs > div {
    padding: var(--space-5);
    border-right: var(--rule) solid var(--border);
    border-bottom: var(--rule) solid var(--border);
  }

  .langs dt {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--text-xl);
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
  }

  .langs dd {
    margin: var(--space-1) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .note {
    margin-top: var(--space-5);
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
</style>
