---
import { getCollection } from 'astro:content';
import Notes from '../../../views/Notes.astro';
import { forLocale } from '../../../i18n/content';

export async function getStaticPaths() {
  const posts = await getCollection('notes', ({ data }) => !data.draft);
  const items = forLocale(posts, 'uk').sort(
    (a, b) => b.entry.data.published.valueOf() - a.entry.data.published.valueOf(),
  );

  if (items.length === 0) return [];

  return [
    { params: { slug: undefined }, props: { items } },
    ...items.map((item) => ({
      params: { slug: item.slug },
      props: { items, post: item.entry, translated: item.translated },
    })),
  ];
}

const { items, post, translated } = Astro.props;
---

<Notes items={items} post={post} translated={translated} locale="uk" />
