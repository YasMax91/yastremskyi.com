---
import { getCollection } from 'astro:content';
import Notes from '../../../views/Notes.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('notes', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
  );

  if (posts.length === 0) return [];

  return [
    { params: { slug: undefined }, props: { posts } },
    ...posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } })),
  ];
}

const { posts, post } = Astro.props;
---

<Notes posts={posts} post={post} locale="uk" />
