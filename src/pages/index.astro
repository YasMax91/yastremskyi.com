---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import ContactForm from '../components/ContactForm.astro';
import portrait from '../assets/portrait.jpeg';
import Base from '../layouts/Base.astro';
import GateSimulator from '../components/GateSimulator.astro';
import { site } from '../data/site';

const cases = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: site.name,
    jobTitle: 'Senior Backend Engineer, Tech Lead',
    email: `mailto:${site.contact.email}`,
    url: site.origin,
    sameAs: [site.contact.linkedin, site.contact.github, site.groundwork.repo],
    knowsLanguage: site.languages.map((l) => l.name),
    address: { '@type': 'PostalAddress', addressCountry: 'UA' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: site.origin,
    inLanguage: 'en',
  },
];
---

<Base
  title={site.name}
  description="Senior backend engineer and tech lead. Payments, order lifecycles and production workflows — plus Groundwork, an open-source platform that makes AI-assisted engineering verifiable."
  current="/"
  jsonLd={jsonLd}
>
  <div class="hero">
    <div class="wrap">
      <p class="label">{site.title} · {site.experience}</p>
      <h1>Max<br />Yastremskyi</h1>
    </div>

    <div class="wrap">
      <div class="hero-meta">
        <div>
          <p class="label">Positioning</p>
          <p class="lede">
            I own the parts of a system that <b>must not be approximately right</b> — money, orders, production
            workflows — and I build the tooling that proves the work was actually done.
          </p>
        </div>
        <div>
          <p class="label">Facts</p>
          <dl class="facts">
            <dt>Stack</dt><dd>PHP 8.4 · Laravel 12 · Node / NestJS</dd>
            <dt>Data</dt><dd>MySQL 8 · Redis · Docker</dd>
            <dt>Based</dt><dd>{site.location}, {site.timezone}</dd>
            <dt>Open to</dt><dd>{site.availability}</dd>
            <dt>Markets</dt><dd>{site.markets.join(' · ')}</dd>
            <dt>Languages</dt>
            <dd>{site.languages.map((l) => `${l.name} ${l.level}`).join(' · ')}</dd>
          </dl>
        </div>
        <div class="portrait-cell">
          {
            /*
              Treated rather than pasted: grayscale in both themes so the one
              vermilion on the page keeps meaning something, and dimmed in dark
              mode because a near-white brick wall at full brightness punches a
              hole in a black page. The frame crops a little tighter than the
              source, which pulls the composition in.
            */
          }
          <Picture
            class="portrait"
            src={portrait}
            alt={site.name}
            formats={['avif', 'webp']}
            fallbackFormat="jpeg"
            widths={[320, 640, 960]}
            sizes="(min-width: 56rem) 18rem, 12rem"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>

    <div class="wrap">
      <div class="cta">
        <a
          class="btn"
          href={`mailto:${site.contact.email}?subject=${encodeURIComponent(site.contact.emailSubject)}`}
        >
          Email me
        </a>
        <a class="btn btn-2" href={site.groundwork.repo}>Groundwork on GitHub</a>
      </div>
    </div>
  </div>

  <section id="groundwork">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="label">Open source · {site.groundwork.licence} · the flagship</p>
          <h2>Groundwork</h2>
        </div>
        <p class="prose">
          A Claude Code plugin that makes verification part of the development process instead of
          leaving it to the human.
        </p>
      </div>

      <blockquote class="pull">
        “An agent will happily write plausible code and just as happily report that it is done.
        Groundwork makes the checking part of the process.”
      </blockquote>

      <dl class="stats">
        <div><dt class="num">{site.stats.codebases}</dt><dd>production codebases</dd></div>
        <div><dt class="num">{site.stats.procedureRuns}</dt><dd>procedure runs</dd></div>
        <div><dt class="num">{site.stats.specsWritten}</dt><dd>written specs</dd></div>
        <div><dt class="num">{site.stats.frontendHandoffs}</dt><dd>frontend hand-offs</dd></div>
        <div><dt class="num">{site.stats.stoppedBeforeCode}</dt><dd>stopped before code</dd></div>
      </dl>
      <p class="asof">Approximate, as of {site.stats.asOf}</p>

      <GateSimulator id="home-sim" />
    </div>
  </section>

  <section id="work">
    <div class="wrap">
      <div class="sec-head">
        <div><p class="label">Selected work</p><h2>Four decisions</h2></div>
        <p class="prose">
          Not feature lists. Each records the constraint, what was chosen over what, and the detail
          a mid-level engineer would have got wrong.
        </p>
      </div>

      <ol class="cases">
        <li>
          <span class="n num">01</span>
          <div>
            <h3><a href="/groundwork">Groundwork</a></h3>
            <p>
              Risk-based task classification L0–L4, {site.groundwork.agents} specialised review agents,
              {site.groundwork.gates} automated gates and {site.groundwork.procedures} workflow procedures,
              shipped under {site.groundwork.licence}.
            </p>
          </div>
          <div class="subtle">
            <b>The subtle part</b>
            <span>
              Roughly one task in three is stopped before any code is written — mis-scoped,
              conflicting with existing behaviour, or cheaper to solve without development.
            </span>
          </div>
        </li>
        {
          cases.map((entry, i) => (
            <li>
              <span class="n num">0{i + 2}</span>
              <div>
                <h3>
                  <a href={`/work/${entry.id}`}>{entry.data.title}</a>
                </h3>
                <p>{entry.data.summary}</p>
                <ul class="tags">
                  {entry.data.stack.map((chip) => (
                    <li>{chip}</li>
                  ))}
                </ul>
              </div>
              <div class="subtle">
                <b>The subtle part</b>
                <span>{entry.data.subtle.split('\n\n')[0]}</span>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="capabilities">
    <div class="wrap">
      <div class="sec-head">
        <div><p class="label">Capability map</p><h2>What I do</h2></div>
        <p class="prose">
          Grouped honestly. No percentages — a bar chart of skills tells a reader nothing they can
          verify.
        </p>
      </div>
      <div class="caps">
        {
          site.capabilities.map((group) => (
            <div>
              <h3>{group.group}</h3>
              <ul>
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="how">
    <div class="wrap">
      <div class="sec-head">
        <div><p class="label">How I work</p><h2>Three rules</h2></div>
        <p class="prose">They are not aspirations. They are what the tooling enforces.</p>
      </div>
      <div class="prin">
        {
          site.principles.map((p) => (
            <div>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="contact">
    <div class="wrap">
      <div class="sec-head">
        <div><p class="label">Contact</p><h2>Available</h2></div>
        <p class="prose">
          Open to Senior Backend and Tech Lead roles — {site.availability.toLowerCase()}. I have
          worked the Israeli and Ukrainian markets, including Hebrew and right-to-left products.
        </p>
      </div>
      <div class="contact-grid">
        <ContactForm />
        <div class="elsewhere">
          <h3>Elsewhere</h3>
          <ul>
            <li><a href={site.contact.linkedin}>LinkedIn</a></li>
            <li><a href={site.contact.github}>GitHub</a></li>
            <li><a href={site.groundwork.repo}>Groundwork</a></li>
            <li><a href="/cv">CV</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    border-bottom: var(--rule) solid var(--border);
    padding-top: var(--space-8);
  }

  h1 {
    font-size: var(--display-xl);
    margin: 0 0 0.2em;
  }

  .hero-meta {
    display: grid;
    border-top: var(--rule) solid var(--border);
  }

  @media (min-width: 56rem) {
    .hero-meta {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr) minmax(0, 18rem);
    }
  }

  .hero-meta > div {
    padding: var(--space-5) var(--space-5) var(--space-5) 0;
  }

  @media (min-width: 56rem) {
    .hero-meta {
      align-items: stretch;
    }
  }

  @media (min-width: 56rem) {
    .hero-meta > div + div {
      padding-left: var(--space-5);
      border-left: var(--rule) solid var(--border);
    }
  }

  .lede {
    max-width: 30ch;
    margin-top: var(--space-3);
    font-size: var(--text-xl);
    line-height: var(--leading-tight);
  }

  .lede b {
    padding: 0 0.18em;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: var(--weight-regular);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .facts {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.35rem var(--space-3);
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .facts dt {
    color: var(--ink-muted);
  }

  .facts dd {
    margin: 0;
  }

  /* The photo is a block in the grid, flush with the rules that bound it —
     not a picture floating inside a padded cell. */
  .portrait-cell {
    padding: 0 !important;
  }

  /* Sized from a measurement, not a preference. At 412px the portrait was
     157,879px of the viewport against 31,642px for the headline, which made the
     photograph the largest contentful paint and pushed LCP to 1.50s — removing
     it from the built page dropped LCP to 1.05s, which is how we know.
     At document size it is smaller than the positioning sentence beside it, so
     the sentence becomes the largest element and the page paints on text rather
     than on an image decode. It also reads better: on a phone the hero should
     lead with the name and the claim, not with a face. */
  .portrait {
    display: block;
    width: 100%;
    max-width: 12rem;
    height: 100%;
    max-height: 26rem;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 24%;
    filter: grayscale(1) contrast(1.06);
  }

  @media (min-width: 56rem) {
    .portrait {
      max-width: none;
    }
  }

  @media (min-width: 56rem) {
    .portrait {
      aspect-ratio: auto;
      max-height: none;
    }
  }

  /* On a black page the white brick behind him would otherwise read as a lamp. */
  :global(:root[data-theme='dark']) .portrait {
    filter: grayscale(1) contrast(1.02) brightness(0.78);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .portrait {
      filter: grayscale(1) contrast(1.02) brightness(0.78);
    }
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    border: var(--rule) solid var(--border);
    border-inline: 0;
  }

  .btn {
    flex: 1 1 16rem;
    padding: var(--space-4);
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .btn + .btn {
    border-left: var(--rule) solid var(--border);
  }

  .btn-2 {
    background: var(--surface);
    color: var(--ink);
  }

  .btn-2:hover {
    background: var(--ink);
    color: var(--surface);
  }

  section {
    border-bottom: var(--rule) solid var(--border);
    padding: var(--space-10) 0;
  }

  @media (min-width: 48rem) {
    section {
      padding: var(--space-16) 0;
    }
  }

  .sec-head {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }

  @media (min-width: 56rem) {
    .sec-head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
      gap: var(--space-8);
      align-items: end;
    }
  }

  .sec-head h2 {
    font-size: var(--display-m);
  }

  .sec-head .prose {
    color: var(--ink-muted);
  }

  .pull {
    max-width: 36ch;
    margin-bottom: var(--space-8);
    padding-left: var(--space-5);
    border-left: 8px solid var(--accent);
    font-size: var(--text-xl);
    line-height: var(--leading-tight);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    border-top: var(--rule) solid var(--border);
    border-left: var(--rule) solid var(--border);
  }

  .stats > div {
    padding: var(--space-5) var(--space-4);
    border-right: var(--rule) solid var(--border);
    border-bottom: var(--rule) solid var(--border);
  }

  .stats dt {
    margin-bottom: var(--space-2);
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--display-s);
    line-height: 0.85;
    letter-spacing: var(--tracking-display);
    color: var(--accent);
  }

  .stats dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .asof {
    margin: var(--space-3) 0 var(--space-10);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .contact-grid {
    display: grid;
    gap: var(--space-8);
  }

  @media (min-width: 56rem) {
    .contact-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 16rem);
    }
  }

  .elsewhere h3 {
    margin-bottom: var(--space-4);
    font-size: var(--text-lg);
  }

  .elsewhere ul {
    padding: 0;
    border-top: var(--rule-thin) solid var(--border);
    list-style: none;
  }

  .elsewhere li {
    padding: var(--space-3) 0;
    border-bottom: var(--rule-thin) solid var(--border);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .cases {
    border-top: var(--rule) solid var(--border);
    padding: 0;
    list-style: none;
  }

  .cases li {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-8) 0;
    border-bottom: var(--rule) solid var(--border);
  }

  @media (min-width: 60rem) {
    .cases li {
      grid-template-columns: minmax(0, 8rem) minmax(0, 1fr) minmax(0, 22rem);
    }
  }

  .cases .n {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--display-s);
    line-height: 0.8;
    letter-spacing: var(--tracking-display);
    color: var(--accent-text);
  }

  .cases h3 {
    margin-bottom: var(--space-3);
    font-size: var(--display-s);
  }

  .cases h3 a {
    text-decoration-thickness: 0.05em;
  }

  .cases p {
    max-width: 54ch;
    color: var(--ink-muted);
  }

  .subtle {
    padding: var(--space-4);
    border: var(--rule) solid var(--accent);
  }

  .subtle b {
    display: block;
    margin-bottom: var(--space-2);
    font-family: var(--font-mono);
    font-weight: var(--weight-regular);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .subtle span {
    font-size: var(--text-sm);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-top: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 0.16rem 0.45rem;
    border: var(--rule-thin) solid var(--border);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .caps,
  .prin {
    display: grid;
    border-top: var(--rule) solid var(--border);
    border-left: var(--rule) solid var(--border);
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }

  .caps > div,
  .prin > div {
    padding: var(--space-5);
    border-right: var(--rule) solid var(--border);
    border-bottom: var(--rule) solid var(--border);
  }

  .caps h3 {
    margin-bottom: var(--space-4);
    font-size: var(--text-lg);
  }

  .caps ul {
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 2;
    color: var(--ink-muted);
  }

  .prin h3 {
    margin-bottom: var(--space-3);
    font-size: var(--text-xl);
    color: var(--accent-text);
  }

  .prin p {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
</style>
