---
import { existsSync } from 'node:fs';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import ButtonRow from '../components/ButtonRow.astro';
import Button from '../components/Button.astro';
import { site } from '../data/site';
import { useTranslations, DEFAULT_LOCALE } from '../i18n/ui';

// The CV is English in every locale by an explicit decision, so it asks for the
// default locale rather than following the page it is linked from.
const t = useTranslations(DEFAULT_LOCALE);
const monthYear = new Intl.DateTimeFormat('en-GB', { month: 'short', year: 'numeric' });
const when = (value: string) =>
  value === 'present' ? t('tl.present') : monthYear.format(new Date(`${value}-01T00:00:00Z`));

/**
 * The PDF is Max's own file rather than something generated from this page, so
 * the two are separate sources by his decision. The link is therefore only
 * rendered when the file is actually there — a CV button that 404s is worse than
 * no button, and the brief allows no broken links.
 */
const hasPdf = existsSync('dist/cv.pdf') || existsSync('public/cv.pdf');

/**
 * There is deliberately no phone number here, on the page or in the PDF.
 *
 * The PDF is printed from this page, so anything rendered here lands in the HTML
 * of /cv — which is indexed. `display: none` hides a value from a reader and not
 * from a crawler, so a print-only phone number would have been published by the
 * very mechanism meant to keep it private.
 *
 * Putting it back means a separate `/cv-print` route, excluded from the sitemap
 * and served noindex, used only as the source for the PDF. That is buildable;
 * it was judged not worth the machinery for a number a recruiter can ask for in
 * one reply, when a downloadable PDF is forwarded, uploaded to applicant systems
 * and scraped regardless of any header on it.
 */

const ACHIEVEMENTS = [
  'Authored and open-sourced Groundwork (MIT) — an AI spec-driven development platform for Claude Code: risk-based task classification, five specialised review agents, automated gates and a companion-plugin ecosystem. Adopted across seven production codebases; roughly one task in three is stopped before code as mis-scoped.',
  'Shipped applied AI to production: voice intake behind schema-constrained, temperature-zero extraction, an intent gateway that validates model output instead of executing it, OCR and computer-vision pipelines — with provider fallback, prompt-injection defence and response-regression tests.',
  'Engineered payment and financial subsystems: card tokenization (tokens only), hierarchical payment requests, idempotency-keyed clearing, multi-currency decimal money with bcmath, accounting and tax export, signed-webhook reconciliation and all-or-nothing document issuance.',
  'Built a reusable multi-market headless commerce platform: storefront JSON API plus back-office admin, a retail and wholesale pricing engine, driver-abstracted payments and delivery, and an ERP catalogue sync.',
  'Delivered order-lifecycle and production-workflow platforms: multi-station scan tracking, quality control, weighted auto-assignment, server-side RBAC and right-to-left document rendering.',
];
---

<Base
  title="CV"
  description="Senior Backend Engineer and Tech Lead — six years across payments, order lifecycles, production workflows and applied AI, on PHP/Laravel and Node/NestJS."
  current="/cv"
  ogCard="cv"
>
  <div class="page-head">
    <div class="wrap">
      <p class="label">{site.title}</p>
      <h1>{site.name}</h1>
      <dl class="meta">
        <div><dt>Based</dt><dd>{site.location}, {site.timezone}</dd></div>
        <div><dt>Open to</dt><dd>{site.availability}</dd></div>
        <div>
          <dt>Email</dt><dd><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></dd>
        </div>
        <div>
          <dt>Profiles</dt>
          <dd>
            <a href={site.contact.linkedin}>LinkedIn</a> · <a href={site.contact.github}>GitHub</a>
          </dd>
        </div>
      </dl>
      {
        hasPdf ? (
          <p class="pdf">
            <a href="/cv.pdf" download>
              Download as PDF
            </a>
            — two pages, printed from this one, so the two cannot say different things.
          </p>
        ) : (
          <p class="pdf pending">
            The PDF version is not built yet. Run `npm run cv` — it is printed from this page, so
            the two can never disagree.
          </p>
        )
      }
    </div>
  </div>

  <Section label="Summary" title="In one paragraph">
    <p class="prose">
      Senior Backend Engineer and Tech Lead with {site.experience} shipping production Laravel platforms
      for CRM, e-commerce, manufacturing and premium-services businesses. I own complex domains end to
      end — order lifecycles, multi-station production workflows, payments, clearing and accounting —
      and design microservice back-ends on PHP 8.4 and Laravel 12, integrating payment, messaging, calendar
      and logistics providers with sandbox-verified reliability. I also build and lead AI-assisted engineering:
      I authored Groundwork, and I ship applied-AI features to production with a strict bias toward tests,
      grounding and verified integrations.
    </p>
  </Section>

  <Section label="Selected achievements" title="What I have actually shipped">
    <ul class="achievements">
      {ACHIEVEMENTS.map((a) => <li>{a}</li>)}
    </ul>
  </Section>

  <Section label="Experience" title="Roles">
    <ol class="roles">
      {
        site.timeline.map((job) => (
          <li>
            <div class="when">
              <span class="num">
                {when(job.from)} — {when(job.to)}
              </span>
            </div>
            <div>
              <h3>{job.role}</h3>
              <p class="org">{job.org}</p>
              <ul>
                {job.highlights.map((h) => (
                  <li>{t(h)}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section label="Technical skills" title="Grouped, not scored">
    <div class="skills">
      {
        site.capabilities.map((group) => (
          <div>
            <h3>{t(group.key)}</h3>
            <ul>
              {group.items.map((item) => (
                <li>{t(item)}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </Section>

  <Section label="Languages & availability" title="Practicalities" last>
    <dl class="langs">
      {
        site.languages.map((l) => (
          <div>
            <dt>{t(l.nameKey)}</dt>
            <dd>{t(l.levelKey)}</dd>
          </div>
        ))
      }
      <div>
        <dt>Availability</dt>
        <dd>{site.availability}</dd>
      </div>
    </dl>
    <ButtonRow>
      <Button
        href={`mailto:${site.contact.email}?subject=${encodeURIComponent(site.contact.emailSubject)}`}
      >
        {site.contact.email}
      </Button>
      {
        hasPdf && (
          <Button href="/cv.pdf" variant="outline">
            Download PDF
          </Button>
        )
      }
    </ButtonRow>
  </Section>
</Base>

<style>
  .page-head {
    padding: var(--space-10) 0 var(--space-8);
    border-bottom: var(--rule) solid var(--border);
  }

  .page-head h1 {
    margin: var(--space-3) 0 var(--space-5);
    font-size: var(--display-l);
  }

  .meta {
    display: grid;
    gap: var(--space-2) var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    padding-top: var(--space-4);
    border-top: var(--rule-thin) solid var(--border);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .meta dt {
    color: var(--ink-muted);
  }

  .meta dd {
    margin: var(--space-1) 0 0;
  }

  .pdf {
    max-width: var(--measure);
    margin-top: var(--space-5);
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .pdf a {
    color: var(--accent-text);
  }

  .achievements,
  .roles {
    padding: 0;
    border-top: var(--rule) solid var(--border);
    list-style: none;
  }

  .achievements > li {
    max-width: var(--measure);
    padding: var(--space-4) 0;
    border-bottom: var(--rule) solid var(--border);
    color: var(--ink-muted);
  }

  .roles > li {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-6) 0;
    border-bottom: var(--rule) solid var(--border);
  }

  @media (min-width: 52rem) {
    .roles > li {
      grid-template-columns: minmax(0, 12rem) minmax(0, 1fr);
      gap: var(--space-8);
    }
  }

  .when {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }

  .roles h3 {
    margin-bottom: var(--space-2);
    font-size: var(--text-xl);
  }

  .org {
    margin-bottom: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent-text);
  }

  .roles ul {
    max-width: var(--measure);
    padding: 0;
    list-style: none;
  }

  .roles ul li {
    padding: var(--space-2) 0;
    border-bottom: var(--rule-thin) solid var(--border);
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .roles ul li:last-child {
    border-bottom: 0;
  }

  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    border-top: var(--rule) solid var(--border);
    border-left: var(--rule) solid var(--border);
  }

  .skills > div {
    padding: var(--space-5);
    border-right: var(--rule) solid var(--border);
    border-bottom: var(--rule) solid var(--border);
  }

  .skills h3 {
    margin-bottom: var(--space-4);
    font-size: var(--text-lg);
  }

  .skills ul {
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 2;
    color: var(--ink-muted);
  }

  .langs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    margin-bottom: var(--space-8);
    border-top: var(--rule) solid var(--border);
    border-left: var(--rule) solid var(--border);
  }

  .langs > div {
    padding: var(--space-5);
    border-right: var(--rule) solid var(--border);
    border-bottom: var(--rule) solid var(--border);
  }

  .langs dt {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--text-xl);
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
  }

  .langs dd {
    margin: var(--space-1) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent-text);
  }

  /* ---------------------------------------------------------------------------
     Print. This is not a styled web page that happens to print — it is the CV,
     and /cv.pdf is generated from it, so what a printer produces and what a
     recruiter downloads are the same document. One source, so the page and the
     PDF cannot drift apart.

     The screen version leads with display type because a visitor is deciding
     whether to read on. A reader holding the CV has already decided, so print
     trades the scale for density: two pages instead of six, and every heading
     doing work.
     --------------------------------------------------------------------------- */
  /* ---------------------------------------------------------------------------
     Print — designed as a document, not as the page with its interface hidden.

     The first attempt was the second thing: shrink the type, drop the nav, keep
     everything else. What came out read like a form, because the direction's 2px
     rules that carry a hero at 90pt become a grid of cages at 8.5pt. A CV is a
     dense, quiet document with one accent and a lot of air, so the boxes are
     gone and the hierarchy is carried by weight, colour and space.
     --------------------------------------------------------------------------- */
  @media print {
    /* Paper has one theme, and the accent survives it — a CV with a single warm
       colour reads as designed; the same page in pure black reads as a fax. */
    :global(:root),
    :global(:root[data-theme='dark']),
    :global(:root[data-theme='light']) {
      --surface: #fff;
      --surface-sunk: #fff;
      --ink: #14110f;
      --ink-muted: #4a4642;
      --border: #d9d4cf;
      --accent: #c4520a;
      --accent-text: #c4520a;
    }

    .pdf,
    :global(.cta) {
      display: none !important;
    }

    /* The 62-character measure is right for reading prose on a screen at 16px.
       At 8.5pt on A4 it leaves half the page empty and breaks the summary into a
       narrow column, so print sets its own. */
    :global(.prose) {
      max-width: none !important;
      font-size: 8.7pt;
      line-height: 1.45;
    }

    /* --- masthead --- */
    .page-head {
      padding: 0 0 0.5rem !important;
      border-bottom: 2pt solid var(--accent) !important;
    }

    .page-head :global(.label) {
      font-size: 8.5pt;
      letter-spacing: 0.18em;
      color: var(--accent) !important;
    }

    .page-head h1 {
      margin: 0.05rem 0 0.35rem !important;
      font-size: 25pt;
      letter-spacing: -0.035em;
    }

    .meta {
      display: flex !important;
      flex-wrap: wrap;
      gap: 0.1rem 1.1rem !important;
      padding-top: 0 !important;
      border-top: 0 !important;
      font-size: 8pt;
    }

    .meta > div {
      display: flex;
      gap: 0.3rem;
      align-items: baseline;
    }

    .meta dt {
      color: var(--ink-muted);
    }

    .meta dd {
      margin: 0;
      color: var(--ink);
    }

    /* On paper a profile is worth its URL; everything else is noise. */
    .meta :global(a[href^='http'])::after {
      content: ' ' attr(href);
      font-size: 6.5pt;
      color: var(--ink-muted);
      word-break: break-all;
    }

    /* --- body --- */
    .achievements,
    .roles {
      border-top: 0 !important;
    }

    .achievements > li {
      position: relative;
      max-width: none;
      padding: 0.12rem 0 0.12rem 0.7rem !important;
      border: 0 !important;
      font-size: 8.5pt;
      line-height: 1.4;
      color: var(--ink);
      break-inside: avoid;
    }

    .achievements > li::before {
      content: '';
      position: absolute;
      top: 0.42rem;
      left: 0;
      width: 3pt;
      height: 3pt;
      background: var(--accent);
    }

    .roles > li {
      display: grid !important;
      grid-template-columns: 5.2rem 1fr !important;
      gap: 0.7rem !important;
      padding: 0.3rem 0 0.15rem !important;
      border: 0 !important;
      break-inside: avoid;
    }

    .when {
      font-size: 7.5pt;
      color: var(--ink-muted);
      padding-top: 0.12rem;
    }

    .roles h3 {
      margin-bottom: 0 !important;
      font-size: 11pt;
      letter-spacing: -0.02em;
      color: var(--ink);
    }

    .org {
      margin-bottom: 0.18rem !important;
      font-size: 8pt;
      color: var(--accent) !important;
    }

    .roles ul {
      max-width: none;
    }

    .roles ul li {
      position: relative;
      padding: 0.06rem 0 0.06rem 0.65rem !important;
      border: 0 !important;
      font-size: 8.3pt;
      line-height: 1.38;
      color: var(--ink-muted);
    }

    .roles ul li::before {
      content: '–';
      position: absolute;
      left: 0;
      color: var(--accent);
    }

    /* --- skills: columns of plain lists, not a table of boxes --- */
    .skills {
      display: grid !important;
      grid-template-columns: repeat(3, 1fr) !important;
      gap: 0 1rem !important;
      border: 0 !important;
    }

    .skills > div {
      padding: 0.2rem 0 0.3rem !important;
      border: 0 !important;
      break-inside: avoid;
    }

    .skills h3 {
      margin-bottom: 0.1rem !important;
      font-size: 8.5pt;
      letter-spacing: 0.02em;
      color: var(--accent) !important;
    }

    .skills ul {
      font-family: var(--font-body);
      font-size: 8pt;
      line-height: 1.45;
      color: var(--ink-muted);
    }

    /* --- languages: one line, not four cells --- */
    .langs {
      display: flex !important;
      flex-wrap: wrap;
      gap: 0.15rem 1.4rem !important;
      margin-bottom: 0 !important;
      border: 0 !important;
    }

    .langs > div {
      display: flex;
      gap: 0.35rem;
      align-items: baseline;
      padding: 0 !important;
      border: 0 !important;
    }

    .langs dt {
      font-family: var(--font-body);
      font-size: 8.5pt;
      letter-spacing: 0;
      text-transform: none;
      color: var(--ink);
    }

    .langs dd {
      margin: 0 !important;
      font-family: var(--font-body);
      font-size: 8.5pt;
      letter-spacing: 0;
      text-transform: none;
      color: var(--ink-muted);
    }
  }
</style>
