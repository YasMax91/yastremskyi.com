---
import { existsSync } from 'node:fs';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import ButtonRow from '../components/ButtonRow.astro';
import Button from '../components/Button.astro';
import { site } from '../data/site';
import { cv, type CvRole } from '../data/cv';
import { useTranslations, DEFAULT_LOCALE } from '../i18n/ui';

// The CV is English in every locale by an explicit decision, so it asks for the
// default locale rather than following the page it is linked from.
const t = useTranslations(DEFAULT_LOCALE);
const monthYear = new Intl.DateTimeFormat('en-GB', { month: 'short', year: 'numeric' });
const when = (value: string) =>
  value === 'present' ? t('tl.present') : monthYear.format(new Date(`${value}-01T00:00:00Z`));

/** `**text**` in cv.ts is emphasis: odd parts of the split are the strong ones. */
const rich = (text: string) => text.split('**');

/**
 * /cv.pdf is printed from this page by `npm run cv`, so the two cannot say
 * different things. The link is only rendered when the file is actually there —
 * a CV button that 404s is worse than no button, and the brief allows no broken
 * links.
 */
const hasPdf = existsSync('dist/cv.pdf') || existsSync('public/cv.pdf');

/**
 * There is deliberately no phone number here, on the page or in the PDF.
 *
 * The PDF is printed from this page, so anything rendered here lands in the HTML
 * of /cv — which is indexed. `display: none` hides a value from a reader and not
 * from a crawler, so a print-only phone number would have been published by the
 * very mechanism meant to keep it private.
 *
 * Max's own CV carries the number; the site's copy of it does not, by his
 * decision of 2026-10-14. `npm run audit` fails on a phone number in any built
 * page.
 */

const roles = site.timeline.map((job) => ({
  ...job,
  ...(cv.roles[job.org as keyof typeof cv.roles] as CvRole),
}));
const wideSkills = cv.skills.filter((s) => s.wide);
const columnSkills = cv.skills.filter((s) => !s.wide);
const host = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '');
---

<Base
  title="CV"
  description="Senior Backend Engineer and Tech Lead — six years across payments, order lifecycles, production workflows and applied AI, on PHP/Laravel and Node/NestJS."
  current="/cv"
  ogCard="cv"
>
  <div class="page-head">
    <div class="wrap">
      <p class="label">{cv.headline}</p>
      <h1>{site.name}</h1>
      <dl class="meta">
        <div><dt>Based</dt><dd>{site.location}, {site.timezone}</dd></div>
        <div><dt>Open to</dt><dd>{cv.availability}</dd></div>
        <div>
          <dt>Email</dt><dd><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></dd>
        </div>
        <div>
          <dt>Profiles</dt>
          <dd>
            <a href={site.contact.linkedin}>LinkedIn</a> · <a href={site.contact.github}>GitHub</a>
          </dd>
        </div>
      </dl>
      {/* The masthead line of the document: on paper a profile is worth its address. */}
      <p class="contact">
        <span>{site.contact.email}</span>
        <span>{host(site.contact.linkedin)}</span>
        <span>{host(site.contact.github)}</span>
        <span>{host(site.origin)}</span>
        <span>{site.location} · {site.timezone}</span>
        <span>{cv.openTo}</span>
      </p>
      {
        hasPdf ? (
          <p class="pdf">
            <a href="/cv.pdf" download>
              Download as PDF
            </a>
            — two pages, printed from this one, so the two cannot say different things.
          </p>
        ) : (
          <p class="pdf pending">
            The PDF version is not built yet. Run `npm run cv` — it is printed from this page, so
            the two can never disagree.
          </p>
        )
      }
    </div>
  </div>

  <Section id="summary" label="Summary" title="In one paragraph">
    <p class="prose summary">
      {rich(cv.summary).map((part, i) => (i % 2 ? <strong>{part}</strong> : part))}
    </p>
  </Section>

  <Section id="achievements" label="Selected achievements" title="What I have actually shipped">
    <ul class="achievements">
      {
        cv.achievements.map((a) => (
          <li>{rich(a).map((part, i) => (i % 2 ? <strong>{part}</strong> : part))}</li>
        ))
      }
    </ul>
  </Section>

  <Section id="experience" label="Experience" title="Roles">
    <ol class="roles">
      {
        roles.map((job) => (
          <li data-role>
            <div class="when">
              <span class="num">
                {when(job.from)} — {when(job.to)}
              </span>
            </div>
            <div class="body">
              <h3>
                <>
                  <span class="org-name">{job.org}</span>
                  <span class="sep"> · </span>
                  <span class="desc">{job.descriptor}</span>
                </>
              </h3>
              <p class="role">{job.role}</p>
              {job.intro && <p class="intro">{job.intro}</p>}
              <ul>
                {job.highlights.map((h) => (
                  <li>{rich(h).map((part, i) => (i % 2 ? <strong>{part}</strong> : part))}</li>
                ))}
              </ul>
              <p class="stack" data-stack>
                <span>Stack:</span> {job.stack}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section id="side-projects" label="Side projects & consulting" title="Outside the day job">
    <ul class="side">
      {
        cv.sideProjects.map((p) => (
          <li>{rich(p).map((part, i) => (i % 2 ? <strong>{part}</strong> : part))}</li>
        ))
      }
    </ul>
  </Section>

  <Section id="skills" label="Technical skills" title="Grouped, not scored">
    <div class="skills">
      {
        wideSkills.map((group) => (
          <div class="group wide">
            <h3>{group.label}</h3>
            <p>{rich(group.text).map((part, i) => (i % 2 ? <strong>{part}</strong> : part))}</p>
          </div>
        ))
      }
      <div class="columns">
        {
          columnSkills.map((group) => (
            <div class="group">
              <h3>{group.label}</h3>
              <p>{rich(group.text).map((part, i) => (i % 2 ? <strong>{part}</strong> : part))}</p>
            </div>
          ))
        }
      </div>
    </div>
  </Section>

  <Section id="languages" label="Languages & availability" title="Practicalities" last>
    <dl class="langs">
      {
        cv.languages.map((l) => (
          <div>
            <dt>{l.name}</dt>
            <dd>{l.level}</dd>
          </div>
        ))
      }
      <div class="avail">
        <dt>Availability</dt>
        <dd>{cv.availability}</dd>
      </div>
    </dl>
    <ButtonRow>
      <Button
        href={`mailto:${site.contact.email}?subject=${encodeURIComponent(site.contact.emailSubject)}`}
      >
        {site.contact.email}
      </Button>
      {
        hasPdf && (
          <Button href="/cv.pdf" variant="outline">
            Download PDF
          </Button>
        )
      }
    </ButtonRow>
  </Section>
</Base>

<style>
  .page-head {
    padding: var(--space-10) 0 var(--space-8);
    border-bottom: var(--rule) solid var(--border);
  }

  .page-head h1 {
    margin: var(--space-3) 0 var(--space-5);
    font-size: var(--display-l);
  }

  .meta {
    display: grid;
    gap: var(--space-2) var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    padding-top: var(--space-4);
    border-top: var(--rule-thin) solid var(--border);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .meta dt {
    color: var(--ink-muted);
  }

  .meta dd {
    margin: var(--space-1) 0 0;
  }

  /* The document's one-line masthead; the screen has the labelled grid above. */
  .contact {
    display: none;
  }

  .pdf {
    max-width: var(--measure);
    margin-top: var(--space-5);
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .pdf a {
    color: var(--accent-text);
  }

  strong {
    color: var(--ink);
    font-weight: var(--weight-bold);
  }

  .achievements,
  .side,
  .roles {
    padding: 0;
    border-top: var(--rule) solid var(--border);
    list-style: none;
  }

  .achievements > li,
  .side > li {
    max-width: var(--measure);
    padding: var(--space-4) 0;
    border-bottom: var(--rule) solid var(--border);
    color: var(--ink-muted);
  }

  .roles > li {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-6) 0;
    border-bottom: var(--rule) solid var(--border);
  }

  @media (min-width: 52rem) {
    .roles > li {
      grid-template-columns: minmax(0, 12rem) minmax(0, 1fr);
      gap: var(--space-8);
    }
  }

  .when {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }

  .roles h3 {
    margin-bottom: var(--space-2);
    font-size: var(--text-xl);
  }

  /* On screen the descriptor is its own line; on paper it follows the name. */
  .roles h3 .sep {
    display: none;
  }

  .roles h3 .desc {
    display: block;
    margin-top: var(--space-1);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    color: var(--ink-muted);
  }

  .role {
    margin-bottom: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent-text);
  }

  .intro {
    max-width: var(--measure);
    margin-bottom: var(--space-3);
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--ink-muted);
  }

  .roles ul {
    max-width: var(--measure);
    padding: 0;
    list-style: none;
  }

  .roles ul li {
    padding: var(--space-2) 0;
    border-bottom: var(--rule-thin) solid var(--border);
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .roles ul li:last-child {
    border-bottom: 0;
  }

  .stack {
    max-width: var(--measure);
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    line-height: 1.7;
    color: var(--ink-muted);
  }

  .stack span {
    color: var(--accent-text);
  }

  .skills {
    border-top: var(--rule) solid var(--border);
    border-left: var(--rule) solid var(--border);
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }

  .group {
    padding: var(--space-5);
    border-right: var(--rule) solid var(--border);
    border-bottom: var(--rule) solid var(--border);
  }

  .group h3 {
    margin-bottom: var(--space-3);
    font-size: var(--text-lg);
  }

  .group p {
    max-width: var(--measure);
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .langs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    margin-bottom: var(--space-8);
    border-top: var(--rule) solid var(--border);
    border-left: var(--rule) solid var(--border);
  }

  .langs > div {
    padding: var(--space-5);
    border-right: var(--rule) solid var(--border);
    border-bottom: var(--rule) solid var(--border);
  }

  .langs dt {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--text-xl);
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
  }

  .langs dd {
    margin: var(--space-1) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent-text);
  }

  /* ---------------------------------------------------------------------------
     Print — the CV as a document, laid out after the one Max works from: a
     one-line masthead, accent section labels over a rule, roles as "Org ·
     what it does" with the dates on the right, the title in the accent, an
     italic intro, en-dash highlights and a small Stack line. In the site's own
     fonts, by his choice, so the PDF and the site read as one family.

     It is not the page with its interface hidden. The direction's 2px rules
     that carry a hero at 90pt become a grid of cages at 8pt, so the boxes are
     gone and the hierarchy is carried by weight, colour and space.
     --------------------------------------------------------------------------- */
  /* Margins of the document Max works from (~13 mm), on this page only. A named
     page, because the site-wide @page in global.css and this one would
     otherwise be ordered by however the bundler happens to emit them. */
  @page cv {
    size: A4;
    margin: 12mm 13mm 12mm;
  }

  @media print {
    :global(body) {
      page: cv;
    }

    /* Paper has one theme, and the accent survives it — a CV with a single warm
       colour reads as designed; the same page in pure black reads as a fax.

       `:root:not([data-theme='light'])` is the OS-dark selector in tokens.css,
       and it outranks a bare :root. Without it here the page printed under a
       dark OS kept `color-scheme: dark`, and Chrome painted the @page margins
       #121212 — measured on the live /cv.pdf, 2026-10-14. */
    :global(:root),
    :global(:root:not([data-theme='light'])),
    :global(:root[data-theme='dark']),
    :global(:root[data-theme='light']) {
      color-scheme: light;
      background: #fff;
      --surface: #fff;
      --surface-sunk: #fff;
      --ink: #14110f;
      --ink-muted: #4a4642;
      --border: #d9d4cf;
      --accent: #c4520a;
      --accent-text: #c4520a;
    }

    .pdf,
    .meta,
    :global(.cta) {
      display: none !important;
    }

    /* The 62-character measure is right for prose on a screen at 16px. On A4 at
       8.5pt it leaves half the page empty, so print sets its own. */
    :global(.prose),
    .achievements > li,
    .side > li,
    .roles ul,
    .intro,
    .stack,
    .group p {
      max-width: none !important;
    }

    /* --- masthead --- */
    .page-head {
      padding: 0 0 0.35rem !important;
      border-bottom: 1pt solid var(--accent) !important;
    }

    .page-head :global(.label) {
      font-family: var(--font-body);
      font-size: 8.6pt;
      font-weight: 600;
      letter-spacing: 0;
      text-transform: none;
      color: var(--accent) !important;
    }

    .page-head h1 {
      margin: 0 0 0.12rem !important;
      font-size: 22pt;
      letter-spacing: -0.03em;
    }

    .contact {
      display: flex;
      flex-wrap: wrap;
      margin: 0.15rem 0 0;
      font-size: 7.4pt;
      color: var(--ink);
    }

    /* Trailing, as in the source document: a wrapped line ends on the dot
       instead of starting with one. */
    .contact span:not(:last-child)::after {
      content: '·';
      margin: 0 0.35rem;
      color: var(--ink-muted);
    }

    strong {
      font-weight: 600;
    }

    /* --- body --- */
    :global(.prose).summary {
      font-size: 8.2pt;
      line-height: 1.32;
      color: var(--ink-muted);
    }

    .achievements,
    .side,
    .roles {
      border-top: 0 !important;
    }

    .achievements > li,
    .side > li {
      position: relative;
      padding: 0.05rem 0 0.05rem 0.7rem !important;
      border: 0 !important;
      font-size: 8pt;
      line-height: 1.3;
      color: var(--ink-muted);
      break-inside: avoid;
    }

    .achievements > li::before {
      content: '';
      position: absolute;
      top: 0.38rem;
      left: 0.05rem;
      width: 3.5pt;
      height: 3.5pt;
      border-radius: 50%;
      background: var(--accent);
    }

    .side > li::before {
      content: '–';
      position: absolute;
      left: 0.05rem;
      color: var(--accent);
    }

    .roles > li {
      display: block !important;
      position: relative;
      padding: 0.3rem 0 0.1rem !important;
      border: 0 !important;
    }

    .when {
      position: absolute;
      top: 0.32rem;
      right: 0;
      font-family: var(--font-body);
      font-size: 7.8pt;
      font-weight: 600;
      color: var(--ink);
    }

    .roles h3 {
      margin: 0 !important;
      padding-right: 7rem;
      font-family: var(--font-body);
      font-size: 9.6pt;
      letter-spacing: -0.01em;
      text-transform: none;
      color: var(--ink);
      break-after: avoid;
    }

    .roles h3 .sep {
      display: inline;
      font-weight: 400;
      color: var(--ink-muted);
    }

    .roles h3 .desc {
      display: inline;
      margin: 0;
      font-size: 9pt;
      color: var(--ink-muted);
    }

    .role {
      margin: 0.02rem 0 0.05rem !important;
      font-family: var(--font-body);
      font-size: 8.3pt;
      font-weight: 600;
      color: var(--accent);
      break-after: avoid;
    }

    .intro {
      margin: 0 0 0.06rem !important;
      font-size: 7.9pt;
      line-height: 1.28;
    }

    .roles ul li {
      position: relative;
      padding: 0.02rem 0 0.02rem 0.7rem !important;
      border: 0 !important;
      font-size: 7.9pt;
      line-height: 1.28;
      color: var(--ink-muted);
      break-inside: avoid;
    }

    .roles ul li::before {
      content: '–';
      position: absolute;
      left: 0.05rem;
      color: var(--accent);
    }

    .stack {
      margin: 0.06rem 0 0 !important;
      font-family: var(--font-body);
      font-size: 7pt;
      line-height: 1.3;
    }

    .stack span {
      font-weight: 600;
      color: var(--ink-muted);
    }

    /* --- skills: the AI groups across the page, the rest in two columns --- */
    .skills,
    .columns {
      display: block !important;
      border: 0 !important;
    }

    .columns {
      column-count: 2;
      column-gap: 1.2rem;
    }

    /* The heading and its text run inline, so the line box is the group's own:
       without a size and leading here they inherit the screen's 16px strut, and
       every line of skills stood 1.7 lines tall — measured, a quarter page. */
    .group {
      padding: 0.04rem 0 0.06rem !important;
      border: 0 !important;
      font-size: 7.9pt;
      line-height: 1.28;
      break-inside: avoid;
    }

    .group h3,
    .group p {
      display: inline;
      font-family: var(--font-body);
      font-size: 7.9pt;
      line-height: 1.28;
    }

    .group h3 {
      margin: 0 !important;
      font-weight: 600;
      letter-spacing: 0;
      text-transform: none;
      color: var(--accent);
    }

    .group h3::after {
      content: ' — ';
      color: var(--ink-muted);
      font-weight: 400;
    }

    .group p {
      color: var(--ink-muted);
    }

    /* --- languages and availability: one line, not four cells --- */
    .langs {
      display: flex !important;
      flex-wrap: wrap;
      gap: 0.1rem 0.8rem !important;
      margin-bottom: 0 !important;
      border: 0 !important;
    }

    .langs > div {
      display: flex;
      gap: 0.3rem;
      align-items: baseline;
      padding: 0 !important;
      border: 0 !important;
    }

    .langs .avail dt {
      display: none;
    }

    .langs .avail dd::before {
      content: '|';
      margin-right: 0.8rem;
      color: var(--border);
    }

    .langs dt,
    .langs dd {
      margin: 0 !important;
      font-family: var(--font-body);
      font-size: 7.8pt;
      letter-spacing: 0;
      text-transform: none;
    }

    .langs dt {
      font-weight: 600;
      color: var(--ink);
    }

    .langs dd {
      color: var(--ink-muted);
    }
  }
</style>
