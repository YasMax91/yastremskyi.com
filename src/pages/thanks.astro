---
import Base from '../layouts/Base.astro';
import ButtonRow from '../components/ButtonRow.astro';
import Button from '../components/Button.astro';

/**
 * Where the endpoint sends a visitor whose browser has JavaScript disabled.
 * Not in the navigation and not in the sitemap — it is a destination, not a page
 * anybody should arrive at from a search result.
 */
---

<Base title="Message sent" description="Your message reached me." current="">
  <div class="wrap panel">
    <p class="label">Sent</p>
    <h1>Thank you</h1>
    <p class="lede">
      Your message reached my inbox. I answer everything that is not a mass mailing, usually within
      a day or two.
    </p>
    <ButtonRow>
      <Button href="/">Back to the start</Button>
      <Button href="/work" variant="outline">Selected work</Button>
    </ButtonRow>
  </div>
</Base>

<style>
  .panel {
    padding: var(--space-16) 0;
  }

  h1 {
    margin: var(--space-3) 0 var(--space-5);
    font-size: var(--display-l);
  }

  .lede {
    max-width: 36ch;
    margin-bottom: var(--space-8);
    font-size: var(--text-xl);
    line-height: var(--leading-tight);
  }
</style>
