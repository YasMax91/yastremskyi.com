---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import GateSimulator from '../components/GateSimulator.astro';
import Stats from '../components/Stats.astro';
import ButtonRow from '../components/ButtonRow.astro';
import Button from '../components/Button.astro';
import { site } from '../data/site';

/**
 * This page is case study #1, not a second page about the same thing. `/work`
 * lists Groundwork first and links here rather than carrying a duplicate.
 */

const PROBLEMS = [
  {
    title: 'It guesses about other people’s APIs',
    body: 'An agent asked what a payment provider returns will produce a confident, well-formatted, entirely invented answer. Groundwork requires a citation from official documentation, or a sandbox result — anything else is recorded as unknown rather than assumed.',
  },
  {
    title: 'It plans from the files it was shown',
    body: 'The change looks contained because nobody looked outward. Discovery maps the blast radius first — callers, events, jobs, policies, cascade relationships, the tests that cover any of it — so the plan is built on connections rather than on the three files in the prompt.',
  },
  {
    title: 'It answers the question it was asked',
    body: 'Which is not always the question worth answering. A separate pass predicts what nobody thought to ask, and the interview puts those decisions back to the person who owns them instead of settling them quietly.',
  },
  {
    title: 'It reports success',
    body: '“It works” is a claim, and a claim is not evidence. A reviewer whose only job is to refute the claim gets to look before it is believed.',
  },
];

const LEVELS = [
  ['L0', 'Typo, comment, documentation', 'None', 'Not required'],
  ['L1', 'Small bug fix', 'None — a targeted self-trace', 'Unless told to apply now'],
  ['L2', 'Normal feature', 'Impact map, conformance', 'Required'],
  ['L3', 'Permissions, migrations, public contracts, financial visibility', 'All five', 'Required'],
  [
    'L4',
    'Financial calculation, order lifecycle, the permission model, destructive migrations',
    'All five, plus an adversarial panel',
    'Human, always',
  ],
];

const AGENTS = [
  {
    name: 'impact-mapper',
    body: 'What will this break? Traces outward from every touched symbol — callers, events, listeners, jobs, scheduled commands, policies, cascade relationships, and the tests covering any of it.',
  },
  {
    name: 'blind-spot-mapper',
    body: 'What did nobody think to ask? Predicts the omitted dimension rather than the existing coupling: unintended consequences, missing requirements, the domain angle the requester is not the expert in.',
  },
  {
    name: 'grounded-researcher',
    body: 'What does the provider actually do? Reads the official documentation and returns findings that each carry a source, or are marked unknown. It is not allowed to guess instead of check.',
  },
  {
    name: 'adversarial-verifier',
    body: 'Is the “it works” claim true? Tries to refute it against real code, official docs and sandbox results. Defaults to skeptical.',
  },
  {
    name: 'conformance-reviewer',
    body: 'Does the diff satisfy the acceptance criteria that were agreed? Judges implementation against spec in a fresh context, and reports gaps rather than style.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: 'Groundwork',
  description:
    'A Claude Code plugin that makes verification part of the development process: risk-based task classification, five specialised review agents, and gates that must be green before anything is called done.',
  codeRepository: site.groundwork.repo,
  license: 'https://opensource.org/licenses/MIT',
  programmingLanguage: 'Shell',
  author: { '@type': 'Person', name: site.name, url: site.origin },
};
---

<Base
  title="Groundwork"
  description="An open-source Claude Code plugin that makes verification part of the development process: risk-based task classification L0–L4, five specialised review agents, and eleven gates."
  current="/groundwork"
  ogCard="groundwork"
  jsonLd={jsonLd}
>
  <div class="page-head">
    <div class="wrap">
      <p class="label">Open source · {site.groundwork.licence} · the flagship</p>
      <h1>Groundwork</h1>
      <p class="lede">
        An agent that is <b>not allowed to say “done”</b> until the work has been checked.
      </p>
      <dl class="meta">
        <div><dt>Licence</dt><dd>{site.groundwork.licence}</dd></div>
        <div><dt>Runs in</dt><dd>Claude Code</dd></div>
        <div><dt>Targets</dt><dd>Laravel backends</dd></div>
        <div><dt>Author</dt><dd>{site.name}</dd></div>
      </dl>
    </div>
  </div>

  <Section
    id="problem"
    label="The problem"
    title="Plausible is not the same as correct"
    lead="Every safeguard below exists because the failure it prevents happened first."
  >
    <blockquote class="pull">
      “An agent will happily write plausible code and just as happily report that it is done.
      Groundwork makes the checking part of the process.”
      <cite>The design principle the plugin is built on</cite>
    </blockquote>

    <ol class="steps">
      {
        PROBLEMS.map((p, i) => (
          <li>
            <span class="n num">0{i + 1}</span>
            <div>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section
    id="design"
    label="The design"
    title="Weight scales with risk"
    lead="A typo and a change to how VAT is calculated do not deserve the same ceremony. Applying the full process to everything is how a process stops being used — so the level decides what runs."
  >
    <div class="table-scroll">
      <table>
        <caption>Task classification L0–L4</caption>
        <thead>
          <tr>
            <th scope="col">Level</th>
            <th scope="col">What it covers</th>
            <th scope="col">Review agents</th>
            <th scope="col">Approval</th>
          </tr>
        </thead>
        <tbody>
          {
            LEVELS.map(([level, covers, agents, approval]) => (
              <tr>
                <th scope="row">{level}</th>
                <td>{covers}</td>
                <td>{agents}</td>
                <td>{approval}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="sim-slot">
      <GateSimulator id="gw-sim" />
    </div>
  </Section>

  <Section
    id="agents"
    label="Review"
    title="Five specialists, one job each"
    lead="Each runs in a fresh context, so the reasoning that produced a mistake cannot quietly reproduce it."
  >
    <div class="agents">
      {
        AGENTS.map((a) => (
          <div>
            <h3>{a.name}</h3>
            <p>{a.body}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <Section
    id="adoption"
    label="Adoption"
    title="In daily use, not in a demo"
    lead="Numbers are approximate and point-in-time, which is why they carry a date."
  >
    <Stats />
    <div class="callout">
      {
        /* h3, not h4: the section above it is an h2, and skipping a level breaks
          the document outline for anyone navigating by headings. It keeps the
          mono micro-label look through a class rather than through its tag. */
      }
      <h3 class="callout-title">The number worth arguing about</h3>
      <p>
        Roughly one task in three never reaches code. Not because the tooling refused, but because
        writing the specification showed the request was mis-scoped, already solved elsewhere, or
        cheaper to handle without development at all.
      </p>
    </div>
  </Section>

  <Section
    id="install"
    label="Install"
    title="Three lines"
    lead="`init` derives thin, domain-only contracts from the code itself and labels anything it had to assume."
    last
  >
    <pre><code>/plugin marketplace add YasMax91/groundwork
/plugin install groundwork@yasmax
/groundwork:init</code></pre>
    <ButtonRow>
      <Button href={site.groundwork.repo}>Read the source</Button>
      <Button href={`mailto:${site.contact.email}?subject=Groundwork`} variant="outline">
        Ask me about it
      </Button>
    </ButtonRow>
  </Section>
</Base>

<style>
  .page-head {
    padding: var(--space-10) 0 var(--space-8);
    border-bottom: var(--rule) solid var(--border);
  }

  .page-head h1 {
    margin: var(--space-3) 0 var(--space-5);
    font-size: var(--display-l);
  }

  .lede {
    max-width: 34ch;
    font-size: var(--text-xl);
    line-height: var(--leading-tight);
  }

  .lede b {
    padding: 0 0.18em;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: var(--weight-regular);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: var(--rule-thin) solid var(--border);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .meta div {
    display: flex;
    gap: var(--space-2);
  }

  .meta dt {
    color: var(--ink-muted);
  }

  .meta dd {
    margin: 0;
  }

  .pull {
    max-width: 36ch;
    margin-bottom: var(--space-8);
    padding-left: var(--space-5);
    border-left: 8px solid var(--accent);
    font-size: var(--text-xl);
    line-height: var(--leading-tight);
  }

  .pull cite {
    display: block;
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-style: normal;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .steps {
    padding: 0;
    border-top: var(--rule) solid var(--border);
    list-style: none;
  }

  .steps li {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5) 0;
    border-bottom: var(--rule) solid var(--border);
  }

  @media (min-width: 52rem) {
    .steps li {
      grid-template-columns: minmax(0, 6rem) minmax(0, 1fr);
      gap: var(--space-5);
    }
  }

  .steps .n {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--display-s);
    line-height: 1;
    letter-spacing: var(--tracking-display);
    color: var(--accent-text);
  }

  .steps h3 {
    margin-bottom: var(--space-2);
    font-size: var(--text-xl);
  }

  .steps p {
    max-width: var(--measure);
    color: var(--ink-muted);
  }

  /* Wide tables scroll inside their own box. The page never scrolls sideways. */
  .table-scroll {
    overflow-x: auto;
    border: var(--rule) solid var(--border);
  }

  table {
    width: 100%;
    min-width: 44rem;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  caption {
    padding: var(--space-4);
    border-bottom: var(--rule) solid var(--border);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-label);
    text-align: left;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  th,
  td {
    padding: var(--space-3) var(--space-4);
    border-bottom: var(--rule-thin) solid var(--border);
    text-align: left;
    vertical-align: top;
  }

  thead th {
    border-bottom: var(--rule) solid var(--border);
    font-family: var(--font-mono);
    font-weight: var(--weight-regular);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--ink-muted);
  }

  tbody th {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    white-space: nowrap;
    color: var(--accent-text);
  }

  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: 0;
  }

  .sim-slot {
    margin-top: var(--space-8);
  }

  .agents {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    border-top: var(--rule) solid var(--border);
    border-left: var(--rule) solid var(--border);
  }

  .agents > div {
    padding: var(--space-5);
    border-right: var(--rule) solid var(--border);
    border-bottom: var(--rule) solid var(--border);
  }

  .agents h3 {
    margin-bottom: var(--space-2);
    font-family: var(--font-mono);
    font-weight: var(--weight-regular);
    font-size: var(--text-sm);
    letter-spacing: 0;
    text-transform: none;
    color: var(--accent-text);
  }

  .agents p {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .callout {
    max-width: var(--measure);
    margin-top: var(--space-5);
    padding: var(--space-5);
    border: var(--rule) solid var(--accent);
  }

  .callout-title {
    margin-bottom: var(--space-2);
    font-family: var(--font-mono);
    font-weight: var(--weight-regular);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .callout p {
    font-size: var(--text-sm);
  }

  pre {
    margin-bottom: var(--space-8);
    padding: var(--space-5);
    background: var(--ink);
    color: var(--surface);
    border-radius: var(--radius);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.9;
  }
</style>
