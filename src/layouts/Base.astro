---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { useTranslations, DEFAULT_LOCALE, LOCALES, localePath, type Locale } from '../i18n/ui';
import { COMPLETE_LOCALES } from '../i18n/reviewed';
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  /** Path of the current page, for the nav's current-page marker. */
  current?: string;
  /** Structured data for this route. Rendered as-is into a JSON-LD script. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /**
   * Name of the Open Graph card for this route, without extension. Cards are
   * generated by `npm run og` and live in public/og. Falls back to the default
   * card rather than to nothing, so a new route always shares something sane.
   */
  ogCard?: string;
}

const {
  title,
  description,
  locale = DEFAULT_LOCALE,
  current = '',
  jsonLd,
  ogCard = 'default',
} = Astro.props;
const t = useTranslations(locale);

/**
 * The same page in the other languages, so search engines treat them as one
 * document in two languages rather than as two competing pages.
 *
 * Only locales whose review is finished appear here. A half-reviewed Ukrainian
 * page is built and readable by anyone holding the link, but it is not offered
 * to a search engine as an alternative to the English one, and it carries
 * `noindex` besides. Publishing a translation nobody has read is the failure
 * this whole gate exists to prevent, and hreflang is one of the doors.
 */
const published: readonly Locale[] = [
  DEFAULT_LOCALE,
  ...LOCALES.filter((l) => l !== DEFAULT_LOCALE && COMPLETE_LOCALES.includes(l)),
];

/** The path with any locale prefix stripped — the shape both locales share. */
const basePath =
  locale === DEFAULT_LOCALE
    ? Astro.url.pathname
    : Astro.url.pathname.replace(new RegExp(`^/${locale}`), '') || '/';

const alternates = published.map((l) => ({
  locale: l,
  href: new URL(localePath(basePath, l), Astro.site ?? site.origin).href,
}));

/** A locale that is still being reviewed must not be indexed. */
const indexable = published.includes(locale);

const canonical = new URL(Astro.url.pathname, Astro.site ?? site.origin).href;
const ogImage = new URL(`/og/${ogCard}.png`, Astro.site ?? site.origin).href;
// The suffix is the name in THIS page's language, or the home page of the
// Ukrainian site would read "Макс Ястремський — Max Yastremskyi".
const siteName = t('site.name');
const fullTitle = title === siteName ? title : `${title} — ${siteName}`;

/**
 * Which font files this page should preload.
 *
 * Preload is the one place that has to decide, because a preload is
 * unconditional by definition: the `unicode-range` rules in fonts.css stop a
 * browser *fetching* a face it has no characters for, but a preload hint fetches
 * it regardless.
 *
 * So preload one script's three faces — the one this page will actually render
 * in — and let the other arrive on demand for the handful of words that need it.
 * A Ukrainian page still says "Groundwork" and "backend" in Latin, and an
 * English page never says anything in Cyrillic.
 *
 * Which set depends on what the page renders, and both answers were measured.
 * While Ukrainian is unreviewed its pages render English, and preloading Cyrillic
 * for them cost 308 ms — /uk went from 1203 ms to 1511 ms and came straight back
 * when the extra three were removed. Once it is published the same page renders
 * both scripts for real — Cyrillic prose, Latin stack names — and then
 * preloading both is the cheaper answer by 147 ms: 1653 ms with Cyrillic alone,
 * 1506 ms with all six, because the Latin faces are needed either way and are
 * otherwise discovered a round trip late.
 *
 * The choice keys off whether the locale is *published*, not merely requested:
 * until its review is finished a Ukrainian page renders English, so preloading
 * Cyrillic for it would buy the wrong glyphs. The rule corrects itself the day
 * the last line is signed.
 */
const rendersCyrillic = locale !== DEFAULT_LOCALE && COMPLETE_LOCALES.includes(locale);

const FONT_PRELOADS = rendersCyrillic
  ? [
      '/fonts/onest-800-cyrillic.woff2',
      '/fonts/onest-400-cyrillic.woff2',
      '/fonts/jetbrains-mono-400-cyrillic.woff2',
      '/fonts/onest-800-latin.woff2',
      '/fonts/onest-400-latin.woff2',
      '/fonts/jetbrains-mono-400-latin.woff2',
    ]
  : [
      '/fonts/onest-800-latin.woff2',
      '/fonts/onest-400-latin.woff2',
      '/fonts/jetbrains-mono-400-latin.woff2',
    ];
---

<!doctype html>
<html lang={locale} data-label-dark={t('theme.toDark')} data-label-light={t('theme.toLight')}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Applied before first paint: a dark-mode visitor must never see a white flash. */}
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {
        // Storage can be blocked (private mode, third-party context). The OS
        // preference then decides, which is the correct fallback anyway.
        void e;
      }
    </script>

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    {
      alternates.length > 1 &&
        alternates.map((a) => <link rel="alternate" hreflang={a.locale} href={a.href} />)
    }
    {
      alternates.length > 1 && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={alternates.find((a) => a.locale === DEFAULT_LOCALE)?.href}
        />
      )
    }

    {
      /*
      Preload is the one place that has to know the page's language, because a
      preload is unconditional by definition — the `unicode-range` rules in
      fonts.css keep a browser from *fetching* a face it has no characters for,
      but a preload hint would fetch it anyway and waste the request.

      So: every page preloads the Latin cut, and a Ukrainian page also preloads
      the Cyrillic one, because it genuinely renders both scripts — its own prose
      in Cyrillic, and "Groundwork", "backend" and every stack name in Latin.

      These sit in front of the first paint, so their size is not a detail:
      dropping the mono preload to save bytes made LCP worse by 150 ms, and
      adding it back made it better. Measured both ways.
    */
    }
    {
      FONT_PRELOADS.map((href) => (
        <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
      ))
    }

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={locale === 'uk' ? 'uk_UA' : 'en_GB'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} — ${siteName}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>

  <body>
    <a class="skip" href="#main">{t('skip.content')}</a>
    <Header locale={locale} current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />

    <style>
      .skip {
        position: absolute;
        left: -9999px;
      }

      .skip:focus {
        position: fixed;
        top: 0;
        left: 0;
        z-index: 99;
        padding: var(--space-3) var(--space-4);
        background: var(--accent);
        color: var(--on-accent);
        font-family: var(--font-mono);
        font-size: var(--text-sm);
      }
    </style>
  </body>
</html>
