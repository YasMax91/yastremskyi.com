---
/**
 * A page section with the standard two-column head: heading on the left,
 * framing prose on the right at wide widths, stacked below 56rem.
 *
 * Every section on the site uses this, which is why the rhythm is consistent
 * without anyone having to remember what the rhythm is.
 */
interface Props {
  /** Mono kicker above the heading. */
  label?: string;
  title: string;
  /** Optional framing sentence, shown beside the heading on wide screens. */
  lead?: string;
  id?: string;
  /** Drop the bottom rule — for the last section before the footer. */
  last?: boolean;
}

const { label, title, lead, id, last = false } = Astro.props;
---

<section id={id} class={last ? 'last' : undefined}>
  <div class="wrap">
    <div class="sec-head">
      <div>
        {label && <p class="label">{label}</p>}
        <h2>{title}</h2>
      </div>
      {lead && <p class="prose">{lead}</p>}
    </div>
    <slot />
  </div>
</section>

<style>
  section {
    padding: var(--space-10) 0;
    border-bottom: var(--rule) solid var(--border);
  }

  section.last {
    border-bottom: 0;
  }

  @media (min-width: 48rem) {
    section {
      padding: var(--space-16) 0;
    }
  }

  /* On paper the mono kicker is the heading and the editorial one is noise:
     a CV wants "Experience", not "Roles" set in 40pt. */
  @media print {
    section {
      padding: 0.5rem 0 0;
      border-bottom: 0;
      break-inside: auto;
    }

    /* `!important` on purpose. The screen layout lives inside a min-width media
       query, and after bundling these rules cannot be relied on to come later —
       measured: the head kept display:grid and a 40px margin, which is where the
       empty band under every heading came from. Print has to win deterministically,
       not by source order. */
    .sec-head {
      display: block !important;
      grid-template-columns: none !important;
      gap: 0 !important;
      margin-bottom: 0.25rem !important;
      padding-top: 0.4rem;
      border-top: 0.5pt solid #000;
      break-after: avoid;
    }

    .sec-head h2 {
      display: none;
    }

    .sec-head :global(.label) {
      font-size: 9pt;
      font-weight: 700;
      letter-spacing: 0.12em;
      color: #000;
    }

    .sec-head .prose {
      display: none;
    }
  }

  .sec-head {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }

  @media (min-width: 56rem) {
    .sec-head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
      gap: var(--space-8);
      align-items: end;
    }
  }

  .sec-head h2 {
    font-size: var(--display-m);
  }

  .sec-head .prose {
    color: var(--ink-muted);
  }
</style>
