---
/**
 * A page section with the standard two-column head: heading on the left,
 * framing prose on the right at wide widths, stacked below 56rem.
 *
 * Every section on the site uses this, which is why the rhythm is consistent
 * without anyone having to remember what the rhythm is.
 */
interface Props {
  /** Mono kicker above the heading. */
  label?: string;
  title: string;
  /** Optional framing sentence, shown beside the heading on wide screens. */
  lead?: string;
  id?: string;
  /** Drop the bottom rule — for the last section before the footer. */
  last?: boolean;
}

const { label, title, lead, id, last = false } = Astro.props;
---

<section id={id} class={`m-rule${last ? ' last' : ''}`}>
  <div class="wrap">
    <div class="sec-head m-reveal">
      <div>
        {label && <p class="label">{label}</p>}
        <h2>{title}</h2>
      </div>
      {lead && <p class="prose">{lead}</p>}
    </div>
    <slot />
  </div>
</section>

<style>
  section {
    position: relative;
    padding: var(--space-10) 0;
  }

  /* Was `border-bottom`. A border cannot be drawn from the left; a positioned
     hairline can, and it lands on the same pixel row. `.m-rule` in motion.css
     sets it in motion and touches no property declared here. */
  section::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: var(--rule);
    background: var(--border);
  }

  section.last::after {
    display: none;
  }

  @media (min-width: 48rem) {
    section {
      padding: var(--space-16) 0;
    }
  }

  .sec-head {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }

  @media (min-width: 56rem) {
    .sec-head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
      gap: var(--space-8);
      align-items: end;
    }
  }

  .sec-head h2 {
    font-size: var(--display-m);
  }

  .sec-head .prose {
    color: var(--ink-muted);
  }

  /* On paper the mono kicker is the heading and the editorial one is noise: a CV
     wants "Experience", not "Roles" set in 40pt. A hairline in the accent under
     each one gives the eye a place to land without drawing a box around
     everything.

     `!important` is load-bearing here. The screen layout lives inside a min-width
     media query and, after bundling, these rules cannot be relied on to come
     later — measured: the head kept display:grid and a 40px margin, which put an
     empty band under every heading in the PDF. */
  @media print {
    section {
      padding: 0.45rem 0 0 !important;
      border-bottom: 0 !important;
      break-inside: auto;
    }

    .sec-head {
      display: block !important;
      grid-template-columns: none !important;
      gap: 0 !important;
      margin-bottom: 0.28rem !important;
      padding-bottom: 0.1rem;
      border-bottom: 0.75pt solid var(--accent);
      break-after: avoid;
    }

    .sec-head h2 {
      display: none;
    }

    .sec-head :global(.label) {
      font-size: 8pt;
      font-weight: 400;
      letter-spacing: 0.2em;
      color: var(--accent);
    }

    .sec-head .prose {
      display: none;
    }
  }
</style>
