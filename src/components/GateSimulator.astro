---
import { useTranslations, type Locale, type UIKey } from '../i18n/ui';

/**
 * The signature element (brief §6). Exactly one, executed properly.
 *
 * Ships ZERO JavaScript: radio inputs plus `:checked` sibling selectors. That
 * makes it keyboard-operable natively — Tab into the group, arrow keys to move —
 * and it keeps working with scripting disabled, which the brief requires of the
 * whole site anyway. The budget allowed under 5 KB of JS for this; it costs none.
 *
 * The levels, agent names and gate names are read from the installed plugin at
 * v0.27.1, not from the brief's older figures.
 *
 * Agent names — `impact-mapper`, `adversarial-verifier` — and the ids below are
 * identifiers rather than prose, so they are the same in every language. What a
 * reader has to understand is translated; what they would have to type is not.
 */

/**
 * A reviewer is either a real agent, named by its identifier, or a description
 * of a whole tier — "everything L3 engages" — which is prose and therefore a
 * key. Typed explicitly because `as const` narrows each entry to its own shape
 * and then no single access is valid across the union.
 */
type Reviewer =
  { name: string; nameKey?: never; role?: UIKey } | { nameKey: UIKey; name?: never; role?: UIKey };

type Level = {
  id: 'typo' | 'bug' | 'feature' | 'access' | 'money';
  reviewers: Reviewer[];
  requires: UIKey[];
};

const LEVELS: Level[] = [
  {
    id: 'typo',
    reviewers: [],
    requires: ['gs.typo.req1'],
  },
  {
    id: 'bug',
    reviewers: [],
    requires: ['gs.bug.req1', 'gs.bug.req2', 'gs.bug.req3'],
  },
  {
    id: 'feature',
    reviewers: [
      { name: 'impact-mapper', role: 'gs.role.break' },
      { name: 'conformance-reviewer', role: 'gs.role.conformance' },
    ],
    requires: ['gs.feature.req1', 'gs.feature.req2', 'gs.feature.req3'],
  },
  {
    id: 'access',
    reviewers: [
      { name: 'impact-mapper' },
      { name: 'blind-spot-map', role: 'gs.role.blindspot' },
      { name: 'grounded-researcher', role: 'gs.role.grounded' },
      { name: 'conformance-reviewer' },
      { name: 'adversarial-verifier', role: 'gs.role.verify' },
    ],
    requires: ['gs.access.req1', 'gs.access.req2', 'gs.access.req3'],
  },
  {
    id: 'money',
    reviewers: [
      { nameKey: 'gs.role.everythingL3' },
      { nameKey: 'gs.role.panel', role: 'gs.role.panelRole' },
    ],
    requires: ['gs.money.req1', 'gs.money.req2', 'gs.money.req3'],
  },
];

const GATES: UIKey[] = [
  'gs.gate.format',
  'gs.gate.analysis',
  'gs.gate.tests',
  'gs.gate.openapi',
  'gs.gate.runner',
  'gs.gate.migrations',
  'gs.gate.edits',
  'gs.gate.unpushed',
  'gs.gate.coverage',
  'gs.gate.intent',
  'gs.gate.contract',
];

interface Props {
  /**
   * Distinguishes one instance from another when a page carries more than one.
   * Explicit rather than random: a build has to be reproducible, and an id that
   * changes every run turns a no-op rebuild into a diff.
   */
  id?: string;
  locale: Locale;
}

const { id = 'gs', locale } = Astro.props;
const t = useTranslations(locale);
const DEFAULT_INDEX = 2;
---

<div class="sim">
  <div class="sim-head">
    <h3>{t('gs.title')}</h3>
    <p>{t('gs.sub')}</p>
  </div>

  {
    LEVELS.map((l, i) => (
      <input
        type="radio"
        name={id}
        id={`${id}-${l.id}`}
        data-level={l.id}
        checked={i === DEFAULT_INDEX}
      />
    ))
  }

  <fieldset>
    <legend class="visually-hidden">{t('gs.chooseTask')}</legend>
    <div class="opts">
      {
        LEVELS.map((l) => (
          <label class={`o-${l.id}`} for={`${id}-${l.id}`}>
            <i>{t(`gs.${l.id}.kind` as UIKey)}</i>
            {t(`gs.${l.id}.task` as UIKey)}
          </label>
        ))
      }
    </div>
  </fieldset>

  <div class="panels">
    {
      LEVELS.map((l) => (
        <div class={`panel m-swap p-${l.id}`}>
          <p class="verdict">{t(`gs.${l.id}.level` as UIKey)}</p>
          <p class="gist">{t(`gs.${l.id}.gist` as UIKey)}</p>
          <div class="cols">
            <div>
              <h4>{t('gs.whoReviews')}</h4>
              {l.reviewers.length === 0 ? (
                <p class="empty">{t(`gs.${l.id}.empty` as UIKey)}</p>
              ) : (
                <ul>
                  {l.reviewers.map((r) => (
                    <li>
                      {r.nameKey ? t(r.nameKey) : r.name}
                      {r.role && <em> — {t(r.role)}</em>}
                    </li>
                  ))}
                </ul>
              )}
            </div>
            <div>
              <h4>{t('gs.whatRequired')}</h4>
              <ul>
                {l.requires.map((r) => (
                  <li>{t(r)}</li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      ))
    }
  </div>

  <div class="gates">
    <span class="label">{t('gs.gatesLabel')}</span>
    <ul class="chips">{GATES.map((g) => <li>{t(g)}</li>)}</ul>
    <small>{t('gs.gatesNote')}</small>
  </div>
</div>

<style>
  .sim {
    border: var(--rule) solid var(--border);
  }

  .sim-head {
    padding: var(--space-5);
    border-bottom: var(--rule) solid var(--border);
    background: var(--ink);
    color: var(--surface);
  }

  .sim-head h3 {
    font-size: var(--display-s);
    margin-bottom: var(--space-2);
  }

  .sim-head p {
    max-width: 56ch;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.7;
    opacity: 0.8;
  }

  .sim input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  fieldset {
    margin: 0;
    padding: 0;
    border: 0;
    border-bottom: var(--rule) solid var(--border);
  }

  .opts {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media (min-width: 52rem) {
    .opts {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .opts label {
    display: block;
    padding: var(--space-4);
    border-bottom: var(--rule) solid var(--border);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.55;
    cursor: pointer;
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  @media (min-width: 52rem) {
    .opts label {
      min-height: 7rem;
      border-right: var(--rule) solid var(--border);
      border-bottom: 0;
    }

    .opts label:last-of-type {
      border-right: 0;
    }
  }

  .opts label i {
    display: block;
    margin-bottom: var(--space-2);
    font-style: normal;
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .opts label:hover {
    background: var(--surface-sunk);
  }

  .sim input:focus-visible + label {
    outline: 3px solid var(--focus);
    outline-offset: -3px;
  }

  .panel {
    display: none;
    padding: var(--space-5);
  }

  /* Matched on a data attribute rather than an id, so a page can carry two
     simulators without the selectors colliding. The `~` combinator keeps each
     rule inside its own .sim. One rule per level, because CSS cannot say "the
     nth panel after the nth checked input". */
  input[data-level='typo']:checked ~ .panels .p-typo,
  input[data-level='bug']:checked ~ .panels .p-bug,
  input[data-level='feature']:checked ~ .panels .p-feature,
  input[data-level='access']:checked ~ .panels .p-access,
  input[data-level='money']:checked ~ .panels .p-money {
    display: block;
  }

  /* The selected task keeps the accent fill. Black on this vermilion measures
     5.88:1; white would be 3.57:1 and fail AA. */
  input[data-level='typo']:checked ~ fieldset .o-typo,
  input[data-level='bug']:checked ~ fieldset .o-bug,
  input[data-level='feature']:checked ~ fieldset .o-feature,
  input[data-level='access']:checked ~ fieldset .o-access,
  input[data-level='money']:checked ~ fieldset .o-money {
    background: var(--accent);
    color: var(--on-accent);
  }

  input[data-level='typo']:checked ~ fieldset .o-typo i,
  input[data-level='bug']:checked ~ fieldset .o-bug i,
  input[data-level='feature']:checked ~ fieldset .o-feature i,
  input[data-level='access']:checked ~ fieldset .o-access i,
  input[data-level='money']:checked ~ fieldset .o-money i {
    color: var(--on-accent);
  }

  .verdict {
    margin-bottom: var(--space-3);
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--display-s);
    line-height: 1;
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    color: var(--ink);
  }

  .gist {
    max-width: var(--measure);
    margin-bottom: var(--space-5);
    color: var(--ink-muted);
  }

  .cols {
    display: grid;
    border-top: var(--rule) solid var(--border);
  }

  @media (min-width: 46rem) {
    .cols {
      grid-template-columns: 1fr 1fr;
    }
  }

  .cols > div {
    padding: var(--space-5) var(--space-5) var(--space-5) 0;
  }

  @media (min-width: 46rem) {
    .cols > div + div {
      padding-left: var(--space-5);
      border-left: var(--rule) solid var(--border);
    }
  }

  .cols ul {
    margin-top: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .cols li {
    padding: var(--space-2) 0;
    border-bottom: var(--rule-thin) solid var(--border);
    font-size: var(--text-sm);
  }

  .cols li:last-child {
    border-bottom: 0;
  }

  .cols li em {
    font-style: normal;
    color: var(--ink-muted);
  }

  .cols .empty {
    margin-top: var(--space-3);
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }

  .gates {
    padding: var(--space-5);
    border-top: var(--rule) solid var(--border);
    background: var(--surface-sunk);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-top: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .chips li {
    padding: var(--space-1) var(--space-2);
    border: var(--rule-thin) solid var(--border);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .gates small {
    display: block;
    max-width: var(--measure);
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.7;
    color: var(--ink-muted);
  }
</style>
