# Caddy site block for yastremskyi.com — AS DEPLOYED on 2026-08-20.
#
# This is not a standalone Caddyfile. The server already runs Caddy inside a
# container (`tiles-web-1`) which owns ports 80 and 443, so this block is
# appended to that project's Caddyfile at /opt/tiles/deploy/Caddyfile and the
# file is bind-mounted into the container. The tiles block above it is untouched,
# and `caddy validate` runs before every reload — if it fails, nothing has
# changed and the site that was already running is still running.
#
#   docker run --rm -e SITE_ADDRESS=... -v /opt/tiles/deploy/Caddyfile:/etc/caddy/Caddyfile:ro \
#     caddy:2-alpine caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
#   docker exec tiles-web-1 caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile
#
# Kept here so the repository holds what actually runs. Copied back from the
# server rather than written from memory.

# ---------------------------------------------------------------------------
# yastremskyi.com — a static personal site sharing this Caddy, because this
# container owns 80 and 443 on the box. Added rather than substituted: the
# tiles block above is untouched.
#
# The file is bind-mounted into the container from this directory, so what runs
# and what this repository tracks are the same file — no rebuild, and no baked
# copy silently diverging from the one on disk.
#
# Behind Cloudflare's proxy the TLS-ALPN challenge cannot work: TLS terminates
# at the edge, so the challenge never reaches this server. Caddy picks a
# challenge at random when several are enabled, which would mean roughly half of
# all issuance attempts failing, so only HTTP-01 is left on.
# ---------------------------------------------------------------------------
# www is one canonical redirect, not a second copy of the site. Serving both
# would be duplicate content competing with itself in search results.
www.yastremskyi.com {
	redir https://yastremskyi.com{uri} permanent
}

yastremskyi.com {
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}

	encode zstd gzip

	# The contact endpoint runs on the host under systemd, bound to loopback.
	# Headers pass through untouched so it can read CF-Connecting-IP — behind the
	# proxy that is the only header carrying the visitor's real address, and the
	# rate limiter is worse than useless without it.
	handle /api/contact* {
		reverse_proxy host.docker.internal:8788
	}

	# The status endpoint, on its own port and its own systemd unit. Same
	# reasoning as above: headers pass through so the ingest rate limiter can see
	# who is calling.
	handle /api/status* {
		reverse_proxy host.docker.internal:8789
	}

	# The CV carries a phone number and names the providers Max integrated. It
	# stays reachable by link and out of the index: a PDF is crawled and ranked
	# exactly like a page, and a search result is not something you can take back.
	header /cv.pdf X-Robots-Tag "noindex, noarchive"

	# Cache-Control, with matchers that genuinely exclude each other.
	#
	# Written first as three path-scoped `header` lines plus a global one, which
	# silently did nothing: Caddy applies every matching header directive, so the
	# global "max-age=0" ran last and overwrote the immutable values. Measured at
	# the origin — the fingerprinted assets were being served with max-age=0.
	@immutable path /_astro/* /fonts/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@og path /og/*
	header @og Cache-Control "public, max-age=604800"

	# Everything else — HTML above all — must revalidate, or a deploy takes days
	# to reach anyone.
	@revalidate not path /_astro/* /fonts/* /og/*
	header @revalidate Cache-Control "public, max-age=0, must-revalidate"

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
		-Server
	}

	# /srv/yastremskyi is the path INSIDE the container. On the host the same
	# directory is /var/www/yastremskyi.com, which is what deploy.sh writes to,
	# bind-mounted read-only:
	#
	#   /var/www/yastremskyi.com -> /srv/yastremskyi (ro)
	#
	# The two paths disagreeing looks like drift and is not. Written down because
	# reading this file next to deploy.sh and concluding one of them is wrong
	# costs more time than the note does.
	handle {
		root * /srv/yastremskyi
		try_files {path} {path}/index.html {path}.html
		file_server
	}

	handle_errors {
		@404 expression {err.status_code} == 404
		rewrite @404 /404.html
		root * /srv/yastremskyi
		file_server
	}
}
