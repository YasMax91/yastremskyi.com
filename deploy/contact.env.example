# Copy to /etc/yastremskyi/contact.env, fill in, then:
#   sudo chown root:root /etc/yastremskyi/contact.env
#   sudo chmod 600 /etc/yastremskyi/contact.env

# From the Resend dashboard. Scope it to sending only.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where messages land.
MAIL_TO=m.yastremskyj@gmail.com

# Must be on a domain verified in Resend, which needs three DNS records:
#   MX   send                 -> feedback-smtp.<region>.amazonses.com   (priority 10)
#   TXT  send                 -> "v=spf1 include:amazonses.com ~all"
#   TXT  resend._domainkey    -> the DKIM value Resend shows during setup
MAIL_FROM=contact@yastremskyi.com

PORT=8788
SITE_ORIGIN=https://yastremskyi.com
