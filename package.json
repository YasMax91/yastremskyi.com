{
  "name": "yastremskyi-com",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Personal engineering site for Max Yastremskyi.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "contrast": "node docs/design/contrast.mjs",
    "verify": "npm run format:check && npm run lint && npm run check && npm run contrast && npm run build && npm run links",
    "og": "node scripts/og.mjs",
    "links": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "eslint": "^9.0.0",
    "eslint-plugin-astro": "^1.3.0",
    "prettier": "^3.4.0",
    "prettier-plugin-astro": "^0.14.1",
    "satori": "^0.29.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0"
  },
  "overrides": {
    "satteri": "0.10.3"
  }
}
