{
  "name": "yastremskyi-com",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Personal engineering site for Max Yastremskyi.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "contrast": "node docs/design/contrast.mjs",
    "verify": "npm run format:check && npm run lint && npm run check && npm test && npm run contrast && npm run facts && npm run build && npm run audit && npm run motion && npm run i18n:check",
    "og": "node scripts/og.mjs",
    "audit": "node scripts/check-html.mjs",
    "test": "node --test server/*.test.mjs",
    "fonts": "node scripts/subset-fonts.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "clean": "rm -rf dist .astro node_modules/.astro",
    "audit:external": "node scripts/check-html.mjs --external",
    "facts": "node scripts/check-facts.mjs",
    "cv": "node scripts/cv-pdf.mjs",
    "motion": "node scripts/check-motion.mjs",
    "i18n": "node scripts/i18n.mjs",
    "i18n:check": "node scripts/i18n.mjs --check"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.0.0",
    "eslint-plugin-astro": "^1.3.0",
    "globals": "^17.11.0",
    "lighthouse": "^13.4.1",
    "prettier": "^3.4.0",
    "prettier-plugin-astro": "^0.14.1",
    "satori": "^0.29.1",
    "subset-font": "^2.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "satteri": "0.10.3"
  }
}
